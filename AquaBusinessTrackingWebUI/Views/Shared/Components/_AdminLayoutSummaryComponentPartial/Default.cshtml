@model AdminDashboardSummaryViewModel

@{
    var productionDays = Model.GetLast7Days.Data
        .Select(x => Convert.ToDateTime(x.Date).Date)
        .ToList();

    var salesLookup = Model.GetLast7Sales.Data
        .GroupBy(x => Convert.ToDateTime(x.Date).Date)
        .ToDictionary(g => g.Key, g => g.Sum(x => x.Production));

    var alignedSalesValues = productionDays
        .Select(d => salesLookup.TryGetValue(d, out var v) ? v : 0m)
        .ToList();

    var rawMaterialLookup = Model.GetLast7RawMateriels.Data
    .GroupBy(x => Convert.ToDateTime(x.Date).Date)
    .ToDictionary(g => g.Key, g => g.Sum(x => x.Production));

    var alignedRawMaterialValues = productionDays
        .Select(d => rawMaterialLookup.TryGetValue(d, out var v) ? v : 0m)
        .ToList();
}

<div class="page-section" id="ozet">

    <div class="section-header">
        <div>
            <div class="section-title">Genel Özet</div>
            <div class="section-sub">KM-2 üretim göstergeleri</div>
        </div>
    </div>

    <div class="ozet-layout">

        <!-- ÜRETİM TREND -->
        <div class="card chart-card">
            <div class="card-title">Üretim Trend</div>
            <div class="chart-wrap-small">
                <canvas id="trendChart"></canvas>
            </div>
        </div>

        <!-- DURUŞ -->
        <div class="card chart-card">
            <div class="card-title">Üretim Trend</div>
            <div class="chart-wrap-small">
                <canvas id="salesProductionChart"></canvas>
            </div>
        </div>

    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(productionDays.Select(d => d.ToString("dd.MM"))));
                                                                                               
                                                               
        const productionValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.GetLast7Days.Data.Select(x => x.Remaning)));
                                                                                               
                                                               
        const salesValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alignedSalesValues));

        const rawMaterialValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(alignedRawMaterialValues));

        // 1) Üretim + Hammadde Girişi trendi
        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Üretim',
                        data: productionValues,
                        borderColor: '#185FA5',
                        backgroundColor: 'rgba(24,95,165,0.15)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: '#185FA5'
                    },
                    {
                        label: 'Hammadde Girişi',
                        data: rawMaterialValues,
                        borderColor: '#e67e22',
                        backgroundColor: 'rgba(230,126,34,0.15)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: '#e67e22'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // 2) Üretim + Satış
        new Chart(document.getElementById('salesProductionChart'), {
            type: 'line',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Üretim',
                        data: productionValues,
                        borderColor: '#185FA5',
                        backgroundColor: 'rgba(24,95,165,0.15)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: '#185FA5'
                    },
                    {
                        label: 'Satış',
                        data: salesValues,
                        borderColor: '#2ecc71',
                        backgroundColor: 'rgba(46,204,113,0.15)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 3,
                        pointHoverRadius: 5,
                        pointBackgroundColor: '#2ecc71'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true
                    }
                },
                scales: {
                    x: {
                        grid: {
                            display: false
                        }
                    },
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    });
</script>