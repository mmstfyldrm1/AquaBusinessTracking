                                <div class="d-flex align-items-center">
                                    <div>
                                        <ion-icon name="log-out-outline"></ion-icon>
                                    </div>
                                    <div class="ms-3"><span>Çıkış Yap</span></div>
                                </div>
                            </button>
                        </form>
                    </li>
                </ul>
            </li>

        </ul>

    </div>
</nav>

<script>
    (function () {
        const notifJwtToken = "@ViewBag.JwtToken";
        const notifApiBaseUrl = "@ViewBag.ApiBaseUrl";
        const notifCurrentUserId = "@ViewBag.CurrentUserId";

        if (!notifJwtToken || !notifCurrentUserId) {
            console.warn("Notification: JWT veya CurrentUserId bulunamadı, bildirim sistemi başlatılmadı.");
            return;
        }

        const notifHubBaseUrl = notifApiBaseUrl.replace(/\/api\/?$/, "");

        function loadUnreadNotifications() {
            fetch(`${notifApiBaseUrl}/notification/unread/${notifCurrentUserId}`, {
                headers: { "Authorization": "Bearer " + notifJwtToken }
            })
                .then(r => r.json())
                .then(list => {
                    const container = document.getElementById('notifList');
                    const badge = document.getElementById('notifBadge');
                    container.innerHTML = '';

                    if (list.length === 0) {
                        container.innerHTML = `<p class="text-center text-muted py-3 mb-0">Bildirim yok</p>`;
                        badge.classList.add('d-none');
                        return;
                    }

                    badge.textContent = list.length;
                    badge.classList.remove('d-none');
                    list.forEach(n => appendNotification(n));
                })
                .catch(err => console.error("Bildirim yükleme hatası:", err));
        }

        function appendNotification(n) {
            document.getElementById('notifList').insertAdjacentHTML('beforeend', buildNotificationHtml(n));
        }

        function prependNotification(n) {
            const container = document.getElementById('notifList');
            const empty = container.querySelector('.text-muted');
            if (empty) container.innerHTML = '';
            container.insertAdjacentHTML('afterbegin', buildNotificationHtml(n));
        }

        function buildNotificationHtml(n) {
           return `
        <a class="dropdown-item" href="javascript:;" data-notif-id="${n.recId}" data-notif-url="${n.url || ''}">
            <div class="d-flex align-items-center">
                <div class="notify text-${n.color}">
                    <ion-icon name="${n.icon}"></ion-icon>
                </div>
                <div class="flex-grow-1">
                    <h6 class="msg-name">
                        ${n.title} <span class="msg-time float-end">${timeAgo(n.insertDate)}</span>
                    </h6>
                    <p class="msg-info">${n.message}</p>
                </div>
            </div>
        </a>`;
        }

        function markAsRead(id, url) {
            fetch(`${notifApiBaseUrl}/notification/mark-as-read/${id}`, {
                method: 'POST',
                headers: { "Authorization": "Bearer " + notifJwtToken }
            }).then(() => {
                if (url) window.location.href = url;
            });
        }

        function incrementBadge() {
            const badge = document.getElementById('notifBadge');
            const current = parseInt(badge.textContent) || 0;
            badge.textContent = current + 1;
            badge.classList.remove('d-none');
        }

        function timeAgo(dateStr) {
            const diff = Math.floor((new Date() - new Date(dateStr)) / 1000);
            if (diff < 60) return "az önce";
            if (diff < 3600) return `${Math.floor(diff / 60)} dk önce`;
            if (diff < 86400) return `${Math.floor(diff / 3600)} sa önce`;
            return `${Math.floor(diff / 86400)} gün önce`;
        }

        document.getElementById('notifList').addEventListener('click', function (e) {
            const item = e.target.closest('[data-notif-id]');
            if (item) markAsRead(item.dataset.notifId, item.dataset.notifUrl);
        });

        document.getElementById('notifMarkAllBtn').addEventListener('click', function () {
            fetch(`${notifApiBaseUrl}/notification/mark-all-as-read/${notifCurrentUserId}`, {
                method: 'POST',
                headers: { "Authorization": "Bearer " + notifJwtToken }
            }).then(() => loadUnreadNotifications());
        });

       
        loadUnreadNotifications();


        function initNotificationHub() {
            if (typeof signalR === 'undefined') {
                setTimeout(initNotificationHub, 50); 
                return;
            }

            const notifConnection = new signalR.HubConnectionBuilder()
                .withUrl(`${notifHubBaseUrl}/notificationHub?access_token=${notifJwtToken}`)
                .withAutomaticReconnect()
                .build();

            notifConnection.on("ReceiveNotification", function (n) {
                prependNotification(n);
                incrementBadge();
            });

            notifConnection.start().catch(err => console.error("Notification SignalR hatası:", err));
        }

        window.addEventListener('load', initNotificationHub);

            function markAsRead(id, url) {
        fetch(`${notifApiBaseUrl}/notification/mark-as-read/${id}`, {
            method: 'POST',
            headers: { "Authorization": "Bearer " + notifJwtToken }
        }).then(() => {
            removeNotificationFromList(id);

            if (url) {
                window.location.href = url;
            }
        }).catch(err => console.error("Okundu işaretleme hatası:", err));
    }

    function removeNotificationFromList(id) {
        const item = document.querySelector(`[data-notif-id="${id}"]`);
        if (item) item.remove();

        decrementBadge();

        const container = document.getElementById('notifList');
        if (container.children.length === 0) {
            container.innerHTML = `<p class="text-center text-muted py-3 mb-0">Bildirim yok</p>`;
        }
    }

    function decrementBadge() {
        const badge = document.getElementById('notifBadge');
        const current = parseInt(badge.textContent) || 0;
        const next = current - 1;

        if (next <= 0) {
            badge.textContent = '0';
            badge.classList.add('d-none');
        } else {
            badge.textContent = next;
        }
    }

        (function () {
        const searchForm = document.querySelector('.searchbar');
        const mobileSearchBtn = document.querySelector('.mobile-search-button');
        const aiSearchUrl = '@Url.Action("Index", "Ai")';

        if (searchForm) {
            searchForm.addEventListener('submit', function (e) {
                e.preventDefault();
            });
            searchForm.addEventListener('click', function () {
                window.location.href = aiSearchUrl;
            });
        }

        if (mobileSearchBtn) {
            mobileSearchBtn.addEventListener('click', function (e) {
                e.preventDefault();
                window.location.href = aiSearchUrl;
            });
        }
    })();
    })();
</script>



