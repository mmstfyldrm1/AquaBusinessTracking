                <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                        <a class="dropdown-item" href="javascript:;">
                            <div class="d-flex flex-row align-items-center gap-2">
                                <img src="@ViewBag.CoverImgUrl" alt="" class="rounded-circle" width="54" height="54">
                                <div class="">
                                    <h6 class="mb-0 dropdown-user-name">@ViewBag.AppUserName  @ViewBag.AppUserSurName</h6>
                                    <small class="mb-0 dropdown-user-designation text-secondary">@ViewBag.DepartmentName</small>
                                </div>
                            </div>
                        </a>
                    </li>
                    <li>
                        <hr class="dropdown-divider">
                    </li>
                    <li>
                        <a class="dropdown-item" href="~/UserProfile/UserProfile">
                            <div class="d-flex align-items-center">
                                <div class="">
                                    <ion-icon name="person-outline"></ion-icon>
                                </div>
                                <div class="ms-3"><span>Profilim</span></div>
                            </div>
                        </a>
                    </li>
                    @{
                        var Energy = User.Claims.Any(c => c.Type == "Permission" && c.Value.Equals("ADMIN.AdminLayoutEnergyComponentPartial.View", StringComparison.OrdinalIgnoreCase));
                        var IntakeRawMaterial = User.Claims.Any(c => c.Type == "Permission" && c.Value.Equals("ADMIN.AdminLayoutIntakeRawMaterialComponentPartial.View", StringComparison.OrdinalIgnoreCase));
                        var NaturelGas = User.Claims.Any(c => c.Type == "Permission" && c.Value.Equals("ADMIN.AdminLayoutNaturelGasTrackingComponentPartial.View", StringComparison.OrdinalIgnoreCase));
                        var Rawmaterials = User.Claims.Any(c => c.Type == "Permission" && c.Value.Equals("ADMIN.AdminLayoutRawmaterialsComponentPartial.View", StringComparison.OrdinalIgnoreCase));
                        var ShippingSales = User.Claims.Any(c => c.Type == "Permission" && c.Value.Equals("ADMIN.AdminLayoutShippingSalesComponentPartial.View", StringComparison.OrdinalIgnoreCase));
                        var Stance = User.Claims.Any(c => c.Type == "Permission" && c.Value.Equals("ADMIN.AdminLayoutStanceComponentPartial.View", StringComparison.OrdinalIgnoreCase));
                        var Statistic = User.Claims.Any(c => c.Type == "Permission" && c.Value.Equals("ADMIN.AdminLayoutStatisticComponentPartial.View", StringComparison.OrdinalIgnoreCase));
                        var Stock = User.Claims.Any(c => c.Type == "Permission" && c.Value.Equals("ADMIN.AdminLayoutStockComponentPartial.View", StringComparison.OrdinalIgnoreCase));
                        var summary = User.Claims.Any(c => c.Type == "Permission" && c.Value.Equals("ADMIN.AdminLayoutSummaryComponentPartial.View", StringComparison.OrdinalIgnoreCase));
                       
                     

                    }
                    <li>
                        @if (CurrentUser.HasPermission("Admin"))
                        {
                            <a class="dropdown-item" href="~/AdminDashboard/Index">
                                <div class="d-flex align-items-center">
                                    <div class="">
                                        <ion-icon name="speedometer-outline"></ion-icon>
                                    </div>
                                    <div class="ms-3"><span>Dashboard</span></div>
                                </div>
                            </a>
                        }
                        @if ((Energy || IntakeRawMaterial || NaturelGas || Rawmaterials || ShippingSales || Stance || Statistic || Stock || summary))
                        {
                            <a class="dropdown-item" href="~/AdminDashboard/Index">
                                <div class="d-flex align-items-center">
                                    <div class="">
                                        <ion-icon name="speedometer-outline"></ion-icon>
                                    </div>
                                    <div class="ms-3"><span> Admin Dashboard</span></div>
                                </div>
                            </a>
                        }

                        @if (!CurrentUser.HasPermission("Admin"))
                        {
                            <a class="dropdown-item" href="~/UserDashboard">
                                <div class="d-flex align-items-center">
                                    <div class="">
                                        <ion-icon name="speedometer-outline"></ion-icon>
                                    </div>
                                    <div class="ms-3"><span>Dashboard</span></div>
                                </div>
