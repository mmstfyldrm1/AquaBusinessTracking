@using DTOLayer.Dtos.UserDashboardDtos
@model List<UserDashboardFavoriteMenuDto>
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">
            <i class="bx bxs-star text-warning me-2"></i>
            Favori Modüllerim
        </h5>
    </div>

    <div class="card-body">

        <div class="row g-3">

            @foreach (var item in Model)
            {
                <div class="col-xl-3 col-lg-4 col-md-6">

                    <a href="@item.Url"
                       class="text-decoration-none">

                        <div class="card border h-100 favorite-card">
                            <div class="card-body text-center">

                                <div class="rounded-circle bg-warning bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3"
                                     style="width:60px;height:60px;">
                                    <i class="bx bx-grid-alt text-warning fs-2"></i>
                                </div>

                                <h6 class="fw-bold text-dark mb-1">
                                    @item.Controller
                                </h6>

                                <small class="text-muted">
                                    Hızlı Erişim
                                </small>

                            </div>
                        </div>

                    </a>

                </div>
            }

        </div>

    </div>
</div>

<style>
    .favorite-card {
        transition: .25s;
        border-radius: 14px;
    }

        .favorite-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.12);
            border-color: #ffc107 !important;
        }
</style>