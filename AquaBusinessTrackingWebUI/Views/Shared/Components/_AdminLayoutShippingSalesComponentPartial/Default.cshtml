@model AdminDashboardSalesShippingViewModel

<style>
    .range-tabs {
        display: flex;
        gap: 6px;
    }

    .range-tab {
        border: 1px solid #d0d7de;
        background: transparent;
        padding: 6px 14px;
        border-radius: 999px;
        cursor: pointer;
        font-size: 13px;
    }

        .range-tab.active {
            background: #185FA5;
            color: #fff;
            border-color: #185FA5;
        }

        .range-tab:disabled {
            opacity: .6;
            cursor: wait;
        }

    #sevk .chart-wrap-small {
        height: 280px;
    }
</style>

<div class="page-section" id="sevk">

    <!-- KPI ROW -->
    <div class="kpi-grid">

        <div class="kpi">
            <div class="kpi-label">Sevk Edilen</div>
            <div class="kpi-val">@Model.TotalShipment</div>
            <div class="kpi-unit">kg</div>
        </div>

        <div class="kpi">
            <div class="kpi-label">Sevkiyat Sayısı</div>
            <div class="kpi-val">@Model.TotalSales</div>
            <div class="kpi-unit">Araç</div>
        </div>

        <div class="kpi">
            <div class="kpi-label">Satış (Dün)</div>
            <div class="kpi-val">@Model.PreviousTotal.ToString("N2")</div>
            <div class="kpi-unit">Kg</div>
        </div>

        <div class="kpi">
            <div class="kpi-label">Satış Tüm</div>
            <div class="kpi-val">@Model.AllTotal.ToString("N2")</div>
            <div class="kpi-unit">Kg</div>
        </div>

    </div>

    <br />

    <div class="row">

        <!-- BAŞLIK + TABLAR (tam genişlik) -->
        <div class="col-12">
            <div class="section-header">
                <div>
                    <div class="section-title">Genel Özet</div>
                    <div class="section-sub">Satış Göstergeleri</div>
                </div>
                <div class="range-tabs" id="salesRangeTabs">
                    <button type="button" class="range-tab active" data-range="7d">Son 7 Gün</button>
                    <button type="button" class="range-tab" data-range="30d">Son 1 Ay</button>
                    <button type="button" class="range-tab" data-range="1y">Son 1 Yıl</button>
                </div>
            </div>
        </div>

        <!-- GRAFİK (yarım genişlik) -->
        <div class="col-lg-6 mb-3">
            <div class="card chart-card h-100">
                <div class="card-title">Satış Trend</div>
                <div class="chart-wrap-small">
                    <canvas id="trendsChart"></canvas>
                </div>
            </div>
        </div>

        <!-- SATIŞ DÜN -->
        <div class="col-lg-6 mb-3">
            <div class="card h-100">
                <div class="card-title">Satış Dün</div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Kağıt Türü</th>
                                <th>Satış</th>
                                <th>İade</th>
                                <th>Kalan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.PreviousDay.Data)
                            {
                                <tr>
                                    <td>@item.PapperType</td>
                                    <td class="fw-bold text-success">@item.Sales.ToString("N2")</td>
                                    <td>@item.Return.ToString("N2")</td>
                                    <td>@item.Stock.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td>Toplam</td>
                                <td class="text-success">@Model.PreviousDay.Data.Sum(x => x.Sales).ToString("N2")</td>
                                <td>@Model.PreviousDay.Data.Sum(x => x.Return).ToString("N2")</td>
                                <td>@Model.PreviousDay.Data.Sum(x => x.Stock).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- SON 10 SEVKİYAT -->
        <div class="col-lg-6 mb-3">
            <div class="card h-100">
                <div class="card-title">Son 10 Sevkiyat</div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Tarih</th>
                                <th>Müşteri</th>
                                <th>Miktar (Kg)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int counter = 1;
                            }
                            @foreach (var item in Model.Last10)
                            {
                                <tr>
                                    <td>@counter</td>
                                    <td>@item.InsertDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@item.CurrentAccountName</td>
                                    <td class="fw-bold text-success">@item.DeliveryQuantity.ToString("N2")</td>
                                </tr>
                                counter++;
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td colspan="3">Toplam</td>
                                <td class="text-success">@Model.Last10.Sum(x => x.DeliveryQuantity).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- SATIŞ TÜM -->
        <div class="col-lg-6 mb-3">
            <div class="card h-100">
                <div class="card-title">Satış Tüm</div>

                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Kağıt Türü</th>
                                <th>Satış</th>
                                <th>İade</th>
                                <th>Kalan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Sales.Data)
                            {
                                <tr>
                                    <td>@item.PapperType</td>
                                    <td class="fw-bold text-success">@item.Sales.ToString("N2")</td>
                                    <td>@item.Return.ToString("N2")</td>
                                    <td>@item.Stock.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr class="fw-bold">
                                <td>Toplam</td>
                                <td class="text-success">@Model.Sales.Data.Sum(x => x.Sales).ToString("N2")</td>
                                <td>@Model.Sales.Data.Sum(x => x.Return).ToString("N2")</td>
                                <td>@Model.Sales.Data.Sum(x => x.Stock).ToString("N2")</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const initial = {
            labels: @Html.Raw(Json.Serialize(Model.Trend.Select(x => x.Date.ToString("dd.MM")))),
            values: @Html.Raw(Json.Serialize(Model.Trend.Select(x => x.Value)))
        };

        const existing = Chart.getChart('trendsChart');
        if (existing) existing.destroy();

        const chart = new Chart(document.getElementById('trendsChart'), {
            type: 'line',
            data: {
                labels: initial.labels,
                datasets: [{
                    label: 'Satış',
                    data: initial.values,
                    borderColor: '#185FA5',
                    backgroundColor: 'rgba(24,95,165,0.15)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 3,
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    pointBackgroundColor: '#185FA5'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                devicePixelRatio: Math.max(window.devicePixelRatio || 1, 2),
                plugins: { legend: { display: false } },
                scales: { x: { grid: { display: false } }, y: { beginAtZero: true } }
            }
        });

        // ---- Tablar ----
        const cache = { '7d': initial };
        const tabs = document.querySelectorAll('#salesRangeTabs .range-tab');

        function applyData(d) {
            chart.data.labels = d.labels;
            chart.data.datasets[0].data = d.values;
            chart.update();
        }

        tabs.forEach(btn => btn.addEventListener('click', async () => {
            const range = btn.dataset.range;
            tabs.forEach(t => t.classList.remove('active'));
            btn.classList.add('active');

            if (cache[range]) { applyData(cache[range]); return; }

            tabs.forEach(t => t.disabled = true);
            try {
                const res = await fetch(`@Url.Action("GetSalesTrend", "AdminDashboard")?range=${range}`);
                if (!res.ok) throw new Error(res.status);
                cache[range] = await res.json();
                applyData(cache[range]);
            } catch (e) {
                console.error('Satış verisi alınamadı', e);
            } finally {
                tabs.forEach(t => t.disabled = false);
            }
        }));
    });
</script>