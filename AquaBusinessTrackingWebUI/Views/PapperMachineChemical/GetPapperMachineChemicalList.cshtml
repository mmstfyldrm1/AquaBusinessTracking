@using DTOLayer.Dtos.PapperMachineChemicalDtos

@{
    ViewData["Title"] = "GetPapperMachineChemicalList";
    Layout = "~/Views/_UserLayout/Index.cshtml";
    var controller = "PapperMachineChemical/GetPapperMachineChemicalList";
}

@model IEnumerable<PapperMachineChemicalDto>

<div class="d-flex justify-content-between align-items-center">
    <h6 class="mb-0 text-uppercase">Kağıt Makinesi Kimyasalları</h6>
    <a asp-controller="UserDashboard"
       asp-action="AddFavorite"
       asp-route-url="@controller"
       class="btn btn-light btn-sm border rounded-pill px-3">
        <i class="bx bx-star text-warning me-1"></i>
        Favorilere Ekle
    </a>
</div>

<hr />

<div class="card">

    <div class="card-body">

        <div class="table-responsive">

            <table id="example2"
                   class="table table-striped table-bordered">

                <thead>

                    <tr>

                        <th>#</th>
                        <th>Stok Kodu</th>
                        <th>Stok Adı</th>
                        <th>Gelen Miktar</th>
                        <th>Tüketilen Miktar</th>
                        <th>Kalan Miktar</th>
                        <th>Stok</th>
                        <th>Tarih</th>
                        <th>Kullanıcı</th>
                        <th>Vardiya</th>
                        <th>Aktif</th>
                        <th>Kayıt Tarihi</th>
                        <th>Güncelle</th>
                        <th>Sil</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int counter = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@counter</td>

                            <td>
                                @(item.InventoryCode ?? "-")
                            </td>

                            <td>
                                @(item.InventoryName ?? "-")
                            </td>

                            <td>
                                @item.IncomingQuantity.ToString("N2")
                            </td>

                            <td>
                                @item.ConsumedQuantity.ToString("N2")
                            </td>

                            <td>
                                @item.RemainingQuantity.ToString("N2")
                            </td>

                            <td>
                                @item.CurrentStock.ToString("N2")
                            </td>

                            <td>
                                @(item.ReceiptDate.ToString("dd.MM.yyyy") ?? "-")
                            </td>

                          

                            <td>
                                @item.CreatedByName
                            </td>

                            <td>
                                @item.ShiftName
                            </td>

                            <td>

                                @if (item.InUse == 1)
                                {
                                    <span class="badge bg-success">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Pasif
                                    </span>
                                }

                            </td>

                            <td>
                                @(item.InsertDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>

                            <td class="text-center">

                                <button class="btn btn-sm btn-outline-warning px-2 py-1"
                                        onclick="openModal(@item.RecId)">

                                    <i class="bi bi-pencil-square fs-6"></i>

                                </button>

                            </td>

                            <td class="text-center">

                                <form method="post"
                                      asp-action="Delete"
                                      asp-route-id="@item.RecId"
                                      style="display:inline;">

                                    <button type="submit"
                                            class="btn btn-sm btn-danger"
                                            onclick="return confirm('Silinsin mi?');">

                                        <ion-icon name="trash-outline"></ion-icon>

                                    </button>

                                </form>

                            </td>

                        </tr>

                        counter++;
                    }

                </tbody>

                <tfoot>

                    <tr>

                        <th>#</th>
                        <th>Stok Kodu</th>
                        <th>Stok Adı</th>
                        <th>Gelen Miktar</th>
                        <th>Tüketilen Miktar</th>
                        <th>Kalan Miktar</th>
                        <th>Stok</th>
                        <th>Tarih</th>
                        <th>Kullanıcı</th>
                        <th>Vardiya</th>
                        <th>Aktif</th>
                        <th>Kayıt Tarihi</th>
                        <th>Güncelle</th>
                        <th>Sil</th>

                    </tr>

                </tfoot>

            </table>

        </div>

        <button class="btn btn-primary shadow-sm"
                onclick="openModal()">

            <ion-icon name="add-circle-outline"></ion-icon>

            Yeni Kayıt Ekle

        </button>

    </div>

</div>

<div id="modalContainer"></div>

<script>
  function openModal(id = null) {
        const url = id
            ? `/PapperMachineChemical/Edit/${id}`
            : `/PapperMachineChemical/Edit`;

        fetch(url)
            .then(r => r.text())
            .then(html => {
                document.getElementById('modalContainer').innerHTML = html;
                const modalEl = document.getElementById('papperMachineChemicalModal');
                const modal = new bootstrap.Modal(modalEl);

                modal.show();

                 $(modalEl).find('.inventory-select').select2({
                dropdownParent: $(modalEl),
                placeholder: 'Stok kodu ara...',
                allowClear: true,
                tags: true,
                width: '100%'
                 });

                 $(document).on('change', '#InventoryCode', function () {
                 var stockName = $(this).find('option:selected').data('name');

                   $('#InventoryName').val(stockName);
                 });

                const form = modalEl.querySelector('form');
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    fetch('/PapperMachineChemical/Edit', {
                        method: 'POST',
                        body: new FormData(this)
                    })
                    .then(r => {
                        if (r.ok) {
                            modal.hide();
                            location.reload();
                        }
                    });
                });

            const incoming = document.getElementById("Entity_IncomingQuantity");
            const consumed = document.getElementById("Entity_ConsumedQuantity");
            const currentStock = document.getElementById("Entity_CurrentStock");
            const remaining = document.getElementById("Entity_RemainingQuantity");

            function calculateRemaining() {

                const incomingValue = parseFloat(incoming.value) || 0;
                const consumedValue = parseFloat(consumed.value) || 0;
                const currentStockValue = parseFloat(currentStock.value) || 0;

                const result = (incomingValue + currentStockValue) - consumedValue;

                remaining.value = result.toFixed(2);
            }

            incoming.addEventListener("input", calculateRemaining);
            consumed.addEventListener("input", calculateRemaining);
            currentStock.addEventListener("input", calculateRemaining);

            calculateRemaining();
            });

         
         
      
    }
</script>

