@using DTOLayer.Dtos.BoilerRoomDailyShiftMonitoringDtos
@using AquaBusinessTrackingWebUI.Models

@model ModalViewModel<BoilerOperationandChemicalConsumptionDto>

<div class="modal fade"
     id="boilerOperationandChemicalConsumptionModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <!-- Header -->
            <div class="modal-header">

                <h5 class="modal-title">
                    @Model.ModalTitle
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <!-- Form -->
            <form method="post"
                  action="/BoilerOperationandChemicalConsumption/Edit">

                <div class="modal-body">

                    <!-- Edit bilgisi -->
                    <input type="hidden"
                           name="IsEdit"
                           value="@Model.IsEdit.ToString().ToLower()" />

                    @if (Model.IsEdit)
                    {
                        <input type="hidden"
                               asp-for="Entity.RecId" />
                    }


                    <div class="row g-3">


                        <!-- Tarih -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Tarih
                            </label>

                            <input asp-for="Entity.ReceiptDate"
                                   type="date"
                                   class="form-control"
                                   required />

                        </div>

                        <!-- Tüketim Yeri -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Tüketim Yeri
                            </label>

                            <select asp-for="Entity.ScalePlaceId"
                                    asp-items="ViewBag.Department"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Ölçüm Noktası
                                </option>

                            </select>

                        </div>
                       


                        <!-- Tüketim Yeri -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Tüketim Tipi
                            </label>

                            <select asp-for="Entity.ConsumptionPlaceId"
                                    asp-items="ViewBag.ConsumptionPlaces"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Tüketim Yeri Seçiniz
                                </option>

                            </select>

                        </div>


                        <!-- Tüketim Miktarı -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Tüketim Miktarı
                            </label>

                            <input asp-for="Entity.ConsumptionQuantity"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control"
                                   placeholder="Tüketim miktarı giriniz"
                                   required />

                        </div>


                        <!-- Açıklama -->
                        <div class="col-md-12">

                            <label class="form-label">
                                Açıklama
                            </label>

                            <textarea asp-for="Entity.Explanation"
                                      rows="4"
                                      class="form-control"
                                      placeholder="Açıklama giriniz..."></textarea>

                        </div>


                        <!-- Durum -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Durum
                            </label>

                            <select asp-for="Entity.InUse"
                                    class="form-select">

                                <option value="1">
                                    Aktif
                                </option>

                                <option value="0">
                                    Pasif
                                </option>

                            </select>

                        </div>

                        <!-- Vardiya -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Vardiya
                            </label>

                            <select asp-for="Entity.ShiftId"
                                    asp-items="ViewBag.Shifts"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Vardiya Seçiniz
                                </option>

                            </select>

                        </div>


                        <!-- Kayıt Eden -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Kayıt Eden
                            </label>

                            <div class="input-group">

                                <span class="input-group-text">
                                    <ion-icon name="person-outline"></ion-icon>
                                </span>

                                <input class="form-control"
                                       value="@ViewBag.AppUserName"
                                       disabled />

                            </div>

                        </div>


                        <!-- Gizli Alanlar -->

                        <input type="hidden"
                               asp-for="Entity.DepartmentId" />

                        <input type="hidden"
                               asp-for="Entity.AppUserId" />

                        <input type="hidden"
                               asp-for="Entity.InsertDate" />

                        <input type="hidden"
                               asp-for="Entity.UpdateDate" />

                        <input type="hidden"
                               asp-for="Entity.DeleteDate" />

                        <input type="hidden"
                               asp-for="Entity.DeletedBy" />

                        <input type="hidden"
                               asp-for="Entity.UpdatedBy" />

                    </div>

                </div>


                <!-- Footer -->
                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        İptal

                    </button>


                    <button type="submit"
                            class="btn btn-success px-4">

                        <ion-icon name="save-outline"></ion-icon>

                        @(Model.IsEdit ? "Güncelle" : "Kaydet")

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>