@using DTOLayer.Dtos.BoilerOperationandChemicalConsumptionDtos
@using DTOLayer.Dtos.BoilerRoomDailyShiftMonitoringDtos
@using AquaBusinessTrackingWebUI.Models

@model ModalViewModel<BoilerOperationandChemicalConsumptionBulkDto>

<div class="modal fade" id="boilerOperationandChemicalConsumptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Model.ModalTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" action="/BoilerOperationandChemicalConsumption/EditBulk">
                <div class="modal-body">

                    <!-- ORTAK ALANLAR -->
                    <div class="row g-3 mb-3">

                        <div class="col-md-4">
                            <label class="form-label">Tarih</label>
                            <input asp-for="Entity.ReceiptDate" type="date" class="form-control" required />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Tüketim Yeri</label>
                            <select asp-for="Entity.ScalePlaceId" asp-items="ViewBag.Department" class="form-select" required>
                                <option value="">Ölçüm Noktası</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Vardiya</label>
                            <select asp-for="Entity.ShiftId" asp-items="ViewBag.Shifts" class="form-select" required>
                                <option value="">Vardiya Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Durum</label>
                            <select asp-for="Entity.InUse" class="form-select">
                                <option value="true">Aktif</option>
                                <option value="false">Pasif</option>
                            </select>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Kayıt Eden</label>
                            <div class="input-group">
                                <span class="input-group-text"><ion-icon name="person-outline"></ion-icon></span>
                                <input class="form-control" value="@ViewBag.AppUserName" disabled />
                            </div>
                        </div>

                    </div>

                    <hr />
                    <h6 class="mb-2">Tüketim Yerlerine Göre Kayıtlar</h6>

                    <!-- 25 LOKASYON LİSTESİ -->
                    <div class="table-responsive" style="max-height:400px; overflow-y:auto;">
                        <table class="table table-sm align-middle">
                            <thead style="position:sticky; top:0; background:#fff; z-index:1;">
                                <tr>
                                    <th>Tüketim Yeri</th>
                                    <th style="width:160px">Miktar</th>
                                    <th>Açıklama</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Entity.Rows.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            @Model.Entity.Rows[i].ConsumptionPlaceName
                                            <input type="hidden" asp-for="Entity.Rows[i].ConsumptionPlaceId" />
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" min="0"
                                                   asp-for="Entity.Rows[i].ConsumptionQuantity"
                                                   class="form-control form-control-sm" />
                                        </td>
                                        <td>
                                            <input type="text"
                                                   asp-for="Entity.Rows[i].Explanation"
                                                   class="form-control form-control-sm"
                                                   placeholder="Opsiyonel" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success px-4">
                        <ion-icon name="save-outline" class="me-1"></ion-icon>
                        Kaydet
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>