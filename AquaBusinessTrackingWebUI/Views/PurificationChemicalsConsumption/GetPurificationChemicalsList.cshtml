@using DTOLayer.Dtos.PurificationChemicalsConsumptionDtos
@{
    ViewData["Title"] = "GetPurificationChemicalsList";
    Layout = "~/Views/_UserLayout/Index.cshtml";
    var controller = "PurificationChemicalsConsumption/GetPurificationChemicalsList";
}
@model List<PurificationChemicalsConsumptionDto>
<style>
    .table-action {
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

        .table-action:hover {
            transform: translateY(-1px);
        }

    .delete-action {
        border: none;
        background: none;
        padding: 0;
    }

    .table-action.text-info:hover {
        color: #087f8c !important;
    }

    .table-action.text-warning:hover {
        color: #d39e00 !important;
    }

    .delete-action:hover {
        color: #b02a37 !important;
    }
</style>
<div class="d-flex justify-content-between align-items-center">
    <h6 class="mb-0 text-uppercase">Arıtma Kimyasal Tüketim(Kg)</h6>
    <a asp-controller="UserDashboard"
       asp-action="AddFavorite"
       asp-route-url="@controller"
       class="btn btn-light btn-sm border rounded-pill px-3">
        <i class="bx bx-star text-warning me-1"></i>
        Favorilere Ekle
    </a>
</div>

<hr />

<div class="card">
    <div class="card-body">
        <div class="table-responsive">

            @{
                var counter = 1;
            }

            <table id="example2" class="table table-striped table-bordered">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Fiş Tarihi</th>
                        <th>Malzeme Kodu</th>
                        <th>Malzeme Adı</th>
                        <th>Ay</th>
                        <th>Gelen</th>
                        <th>Tüketilen</th>
                        <th>Kalan</th>
                        <th>Stok</th>
                        <th>Vardiya</th>
                        <th>Durum</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@counter</td>
                            <td>@item.ReceiptDate.ToString("dd.MM.yyyy")</td>
                            <td>@item.InventoryCode</td>
                            <td>@item.InventoryName</td>
                            <td>@item.Month</td>

                            <td>@item.IncomingQuantity.ToString("N2")</td>
                            <td>@item.ConsumedQuantity.ToString("N2")</td>
                            <td>@item.RemainingQuantity.ToString("N2")</td>

                            <td>@item.CurrentStock.ToString("N2")</td>
                            <td>@item.ShiftName</td>

                            <td>
                                @if (item.InUse == 1)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pasif</span>
                                }
                            </td>

                            <td>@item.InsertDate?.ToString("dd.MM.yyyy HH:mm")</td>

                            <td>@item.CreatedByName</td>

                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Güncelle -->
                                    <a href="javascript:void(0);"
                                       class="table-action text-warning"
                                       onclick="openModal(@item.RecId)"
                                       title="Güncelle">
                                        <ion-icon name="pencil-outline"></ion-icon>
                                    </a>

                                    <!-- Sil -->
                                    <form method="post"
                                          asp-action="Delete"
                                          asp-route-id="@item.RecId"
                                          style="display:inline;">

                                        <button type="submit"
                                                class="table-action delete-action"
                                                onclick="return confirm('Silinsin mi?');"
                                                title="Sil">
                                            <ion-icon name="trash-outline"></ion-icon>
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>

                        counter++;
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th>#</th>
                        <th>Fiş Tarihi</th>
                        <th>Malzeme Kodu</th>
                        <th>Malzeme Adı</th>
                        <th>Ay</th>
                        <th>Gelen</th>
                        <th>Tüketilen</th>
                        <th>Kalan</th>
                        <th>Stok</th>
                        <th>Vardiya</th>
                        <th>Durum</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th>İşlemler</th>
                    </tr>
                </tfoot>

            </table>

        </div>

        <button class="btn btn-primary shadow-sm" onclick="openModal()">
            <ion-icon name="add-circle-outline"></ion-icon>
            Yeni Kayıt Ekle
        </button>

    </div>
</div>

<div id="modalContainer"></div>

<script>
           function openModal(id = null) {
        const url = id
            ? `/PurificationChemicalsConsumption/Edit/${id}`
            : `/PurificationChemicalsConsumption/Edit`;

        fetch(url)
            .then(r => r.text())
            .then(html => {
                document.getElementById('modalContainer').innerHTML = html;
                const modalEl = document.getElementById('purificationChemicalsConsumptionModal');
                const modal = new bootstrap.Modal(modalEl);

                modal.show();
                 $(modalEl).find('.inventory-select').select2({
                dropdownParent: $(modalEl),
                placeholder: 'Stok kodu ara...',
                allowClear: true,
                tags: true,
                width: '100%'
                 });

                 $(document).on('change', '#InventoryCode', function () {
                 var stockName = $(this).find('option:selected').data('name');

                   $('#InventoryName').val(stockName);
                 });

                const form = modalEl.querySelector('form');
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    fetch('/PurificationChemicalsConsumption/Edit', {
                        method: 'POST',
                        body: new FormData(this)
                    })
                    .then(r => {
                        if (r.ok) {
                            modal.hide();
                            location.reload();
                        }
                    });
                });
                 const incoming = document.getElementById("Entity_IncomingQuantity");
            const consumed = document.getElementById("Entity_ConsumedQuantity");
            const currentStock = document.getElementById("Entity_CurrentStock");
            const remaining = document.getElementById("Entity_RemainingQuantity");

            function calculateRemaining() {

                const incomingValue = parseFloat(incoming.value) || 0;
                const consumedValue = parseFloat(consumed.value) || 0;
                const currentStockValue = parseFloat(currentStock.value) || 0;

                const result = (incomingValue + currentStockValue) - consumedValue;

                remaining.value = result.toFixed(2);
            }

            incoming.addEventListener("input", calculateRemaining);
            consumed.addEventListener("input", calculateRemaining);
            currentStock.addEventListener("input", calculateRemaining);

            calculateRemaining();
            });
    }
</script>
