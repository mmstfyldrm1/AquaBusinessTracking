@using DTOLayer.Dtos.VechileFuelLogsDtos

@{
    ViewData["Title"] = "GetVechileFuelLogsList";
    Layout = "~/Views/_UserLayout/Index.cshtml";
    var controller = "VechileFuelLogs/GetVechileFuelLogsList";
}

@model IEnumerable<VechileFuelLogsDto>
<style>
    .table-action {
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

        .table-action:hover {
            transform: translateY(-1px);
        }

    .delete-action {
        border: none;
        background: none;
        padding: 0;
    }

    .table-action.text-info:hover {
        color: #087f8c !important;
    }

    .table-action.text-warning:hover {
        color: #d39e00 !important;
    }

    .delete-action:hover {
        color: #b02a37 !important;
    }
</style>
<div class="d-flex justify-content-between align-items-center">
    <h6 class="mb-0 text-uppercase"> Yakıt Takip Raporu</h6>
    <a asp-controller="UserDashboard"
       asp-action="AddFavorite"
       asp-route-url="@controller"
       class="btn btn-light btn-sm border rounded-pill px-3">
        <i class="bx bx-star text-warning me-1"></i>
        Favorilere Ekle
    </a>
</div>

<hr />


<div class="card">
    <div class="card-body">

        <div class="table-responsive">
            <table id="example2" class="table table-striped table-bordered">

                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tarih</th>
                        <th>Araç Plakası</th>
                        <th>Araç Adı</th>
                        <th>Motor Saati/KM</th>
                        <th>Verilen Mazot (Lt)</th>
                        <th>Mazot Lt Fiyatı</th>
                        <th>Toplam Tutar</th>
                        <th>Teslim Alan</th>
                        <th>İlgili Birim</th>    
                        <th>Kullanıcı</th>
                        <th>Vardiya</th>
                        <th>Aktif</th>
                        <th>Kayıt Tarihi</th>
                        <th>Güncelleme</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        int counter = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@counter</td>

                            <td>
                                @(item.ReceiptDate.ToString("dd.MM.yyyy") ?? "-")
                            </td>

                            <td>
                                @(item.VehicleLicensePlate ?? "-")
                            </td>

                            <td>
                                @(item.VehicleName ?? "-")
                            </td>

                            <td>
                                @(item.EngineHourOrKm ?? "-")
                            </td>

                            <td>
                                @item.FuelDeliveredLiters?.ToString("N2")
                            </td>

                            <td>
                                @item.FuelPricePerLiter?.ToString("N2")
                            </td>

                            <td>
                                @item.TotalAmount?.ToString("N2")
                            </td>

                            <td>
                                @(item.Recipient ?? "-")
                            </td>

                            <td>
                                @(item.ResponsibleDepartment ?? "-")
                            </td>

                            <td>
                                @(item.CreatedByName ?? "-")
                            </td>

                            <td>
                                @(item.ShiftName ?? "-")  
                            </td>

                            <td>
                                @if (item.InUse == 1)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pasif</span>
                                }
                            </td>

                            <td>
                                @(item.InsertDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>

                            <td>
                                @(item.UpdateDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Güncelle -->
                                    <a href="javascript:void(0);"
                                       class="table-action text-warning"
                                       onclick="openModal(@item.RecId)"
                                       title="Güncelle">
                                        <ion-icon name="pencil-outline"></ion-icon>
                                    </a>

                                    <!-- Sil -->
                                    <form method="post"
                                          asp-action="Delete"
                                          asp-route-id="@item.RecId"
                                          style="display:inline;">

                                        <button type="submit"
                                                class="table-action delete-action"
                                                onclick="return confirm('Silinsin mi?');"
                                                title="Sil">
                                            <ion-icon name="trash-outline"></ion-icon>
                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>

                        counter++;
                    }

                </tbody>

                <tfoot>
                    <tr>
                        <th>#</th>
                        <th>Tarih</th>
                        <th>Plaka</th>
                        <th>Araç Adı</th>
                        <th>Motor Saat/KM</th>
                        <th>Mazot (Lt)</th>
                        <th>Lt Fiyat</th>
                        <th>Toplam</th>
                        <th>Teslim Alan</th>
                        <th>İlgili Birim</th>
                        <th>Kullanıcı</th>
                        <th>Vardiya</th>
                        <th>Aktif</th>
                        <th>Kayıt</th>
                        <th>Güncelleme</th>
                        <th>İşlemler</th>
                    </tr>
                </tfoot>

            </table>
        </div>

        <button class="btn btn-primary shadow-sm" onclick="openModal()">
            <ion-icon name="add-circle-outline"></ion-icon>
            Yeni Kayıt Ekle
        </button>

    </div>
</div>

<div id="modalContainer"></div>

<script>
           function openModal(id = null) {
        const url = id
            ? `/VechileFuelLogs/Edit/${id}`
            : `/VechileFuelLogs/Edit`;

        fetch(url)
            .then(r => r.text())
            .then(html => {
                document.getElementById('modalContainer').innerHTML = html;
                const modalEl = document.getElementById('vechileFuelLogsModal');
                const modal = new bootstrap.Modal(modalEl);

                modal.show();

                const form = modalEl.querySelector('form');
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    fetch('/VechileFuelLogs/Edit', {
                        method: 'POST',
                        body: new FormData(this)
                    })
                    .then(r => {
                        if (r.ok) {
                            modal.hide();
                            location.reload();
                        }
                    });
                });
            });
    }
</script>
