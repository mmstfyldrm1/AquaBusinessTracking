@using System.ComponentModel
@using Microsoft.AspNetCore.Mvc.Rendering
@using DTOLayer.Dtos.LogisticsTrackingReportDtos
@using static EntityLayer.Enums.Enums
@model ModalViewModel<LogisticsTrackingReportDto>

<div class="modal fade" id="logisticsTrackingReportModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Model.ModalTitle</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <form method="post" action="/LogisticsTrackingReport/Edit">
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <input type="hidden" name="IsEdit" value="@Model.IsEdit.ToString().ToLower()" />

                    @if (Model.IsEdit)
                    {
                        <input type="hidden" asp-for="Entity.RecId" />
                    }

                    <input type="hidden" asp-for="Entity.DepartmentId" />
                    <input type="hidden" asp-for="Entity.AppUserId" />
                    <input type="hidden" asp-for="Entity.InsertDate" />

                    <h6 class="fw-bold text-muted mb-3">
                        Lojistik Takip Bilgileri
                    </h6>

                    <div class="row g-3">

                        <!-- Tarih -->
                        <div class="col-md-4">
                            <label class="form-label">Tarih</label>
                            <input type="date"
                                   asp-for="Entity.ReceiptDate"
                                   class="form-control"
                                   required />
                        </div>

                        <!-- Plan -->
                        <div class="col-md-4">
                            <label class="form-label">Sevkiyat Planı</label>
                            <select asp-for="Entity.ShipmentPlanId" 
                                    asp-items="ViewBag.Plans"
                                    class="form-select"
                                    required>
                                <option value="">Sevkiyat Planı Seçiniz</option>
                            </select>
                        </div>

                        <!-- İşlem Yapılan Firma -->
                        <div class="col-md-4">
                            <label class="form-label">İşlem Yapılan Firma</label>
                            <input asp-for="Entity.ProcessingCompany"
                                   class="form-control" />
                        </div>

                        <!-- Nakliye Firması -->
                        <div class="col-md-4">
                            <label class="form-label">Nakliye Firması</label>
                            <input asp-for="Entity.CarrierCompany"
                                   class="form-control" />
                        </div>

                        <!-- Çıkış -->
                        <div class="col-md-4">
                            <label class="form-label">Çıkış Yeri</label>
                            <input asp-for="Entity.DepartureLocation"
                                   class="form-control" />
                        </div>

                        <!-- Varış Ülke -->
                        <div class="col-md-4">
                            <label class="form-label">Varış Ülke</label>
                            <input asp-for="Entity.ArrivalCountry"
                                   class="form-control" />
                        </div>

                        <!-- Varış Şehri -->
                        <div class="col-md-4">
                            <label class="form-label">Varış Şehri</label>
                            <input asp-for="Entity.ArrivalCity"
                                   class="form-control" />
                        </div>

                        <!-- Varış İlçesi -->
                        <div class="col-md-4">
                            <label class="form-label">Varış İlçesi</label>
                            <input asp-for="Entity.ArrivalDistrict"
                                   class="form-control" />
                        </div>

                        <!-- Varış Adresi -->
                        <div class="col-md-4">
                            <label class="form-label">Varış Adresi</label>
                            <input asp-for="Entity.ArrivalAddress"
                                   class="form-control" />
                        </div>

                        <!-- Çekici -->
                        <div class="col-md-4">
                            <label class="form-label">Çekici Plakası</label>
                            <input asp-for="Entity.TruckPlate"
                                   class="form-control" />
                        </div>

                        <!-- Dorse -->
                        <div class="col-md-4">
                            <label class="form-label">Dorse Plakası</label>
                            <input asp-for="Entity.TrailerPlate"
                                   class="form-control" />
                        </div>

                        <!-- Dorse Tipi -->
                        <div class="col-md-4">
                            <label class="form-label">Dorse Tipi</label>
                            <input asp-for="Entity.TrailerType"
                                   class="form-control" />
                        </div>

                        <!-- Sürücü -->
                        <div class="col-md-4">
                            <label class="form-label">Sürücü Adı</label>
                            <input asp-for="Entity.DriverName"
                                   class="form-control" />
                        </div>

                        <!-- Telefon -->
                        <div class="col-md-4">
                            <label class="form-label">Sürücü Telefonu</label>
                            <input asp-for="Entity.DriverPhone"
                                   class="form-control" />
                        </div>

                        <!-- Kimlik -->
                        <div class="col-md-4">
                            <label class="form-label">T.C. Kimlik No</label>
                            <input asp-for="Entity.DriverIdentityNumber"
                                   class="form-control" />
                        </div>

                        <!-- Fatura -->
                        <div class="col-md-4">
                            <label class="form-label">Fatura No</label>
                            <input asp-for="Entity.InvoiceNumber"
                                   class="form-control" />
                        </div>

                        <!-- Kantar -->
                        <div class="col-md-4">
                            <label class="form-label">Kantar Miktarı</label>
                            <input asp-for="Entity.ScaleQuantity"
                                   type="number"
                                   step="0.01"
                                   class="form-control" />
                        </div>

                        <!-- Bobin -->
                        <div class="col-md-4">
                            <label class="form-label">Bobin Miktarı</label>
                            <input asp-for="Entity.CoilQuantity"
                                   type="number"
                                   step="0.01"
                                   class="form-control" />
                        </div>

                        <!-- Giriş -->
                        <div class="col-md-4">
                            <label class="form-label">Yükleme Giriş Saati</label>
                            <input asp-for="Entity.LoadingEntryTime"
                                   type="time"
                                   class="form-control" />
                        </div>

                        <!-- Çıkış -->
                        <div class="col-md-4">
                            <label class="form-label">Yükleme Çıkış Saati</label>
                            <input asp-for="Entity.LoadingDepartureTime"
                                   type="time"
                                   class="form-control" />
                        </div>

                        <!-- Operasyon -->
                        <div class="col-md-4">
                            <label class="form-label">Operasyon Süresi</label>
                            <input asp-for="Entity.OperationDuration"
                                   type="time"
                                   class="form-control" />
                        </div>
                        <!-- Durum -->
                        <select asp-for="Entity.Status"
                                asp-items="Html.GetEnumSelectList<ShipmentStatus>()"
                                class="form-select">
                        </select>

                        <!-- Vardiya -->
                        <div class="col-md-4">
                            <label class="form-label">Vardiya</label>
                            <select asp-for="Entity.ShiftId"
                                    asp-items="ViewBag.Shifts"
                                    class="form-select"
                                    required>
                                <option value="">Vardiya Seçiniz</option>
                            </select>
                        </div>

                        <!-- Kullanıcı -->
                        <div class="col-md-4">
                            <label class="form-label">Kayıt Eden</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <ion-icon name="person-outline"></ion-icon>
                                </span>

                                <input type="text"
                                       class="form-control"
                                       value="@ViewBag.AppUserName"
                                       disabled />
                            </div>
                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        İptal
                    </button>

                    <button type="submit"
                            class="btn btn-success px-4">

                        <ion-icon name="save-outline"
                                  class="me-1"></ion-icon>

                        @(Model.IsEdit ? "Güncelle" : "Kaydet")

                    </button>

                </div>

            </form>

        </div>
    </div>
</div>