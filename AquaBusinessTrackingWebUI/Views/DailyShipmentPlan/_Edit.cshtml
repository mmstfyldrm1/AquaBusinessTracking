@using DTOLayer.Dtos.DailyShipmentPlanDtos

@model ModalViewModel<DailyShipmentPlanDto>

<style>
    /* --- Select2 kutusunun kendisi: Bootstrap form-control ile aynı yükseklik/hizada --- */
    #DailyShipmentPlanModal .select2-container {
        width: 100% !important;
    }

        #DailyShipmentPlanModal .select2-container .select2-selection--single {
            height: 38px;
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            display: flex;
            align-items: center;
            padding: 0 0.75rem;
        }

            #DailyShipmentPlanModal .select2-container .select2-selection--single .select2-selection__rendered {
                line-height: normal;
                padding: 0;
                color: #212529;
            }

            #DailyShipmentPlanModal .select2-container .select2-selection--single .select2-selection__arrow {
                height: 36px;
                right: 8px;
            }

    #DailyShipmentPlanModal .select2-container--focus .select2-selection--single,
    #DailyShipmentPlanModal .select2-container--open .select2-selection--single {
        border-color: #86b7fe;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
    }

    /* --- Açılır liste: modal'ın üstünde, düzgün gölgeli, kesin scroll'lu --- */
    .select2-container--open .select2-dropdown {
        z-index: 1200; /* Bootstrap modal (1055) üzerinde kalsın */
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    /* Arama kutusu (dropdown'ın en üstü) */
    .select2-container--open .select2-search--dropdown {
        padding: 0.5rem;
    }

        .select2-container--open .select2-search--dropdown .select2-search__field {
            border: 1px solid #ced4da;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            outline: none;
        }

    /* Sonuç listesi: sabit maksimum yükseklik + dikey scroll garanti */
    .select2-results__options {
        max-height: 260px;
        overflow-y: auto;
    }

        /* Scrollbar'ı biraz daha zarif göster (WebKit tarayıcılar: Chrome/Edge) */
        .select2-results__options::-webkit-scrollbar {
            width: 8px;
        }

        .select2-results__options::-webkit-scrollbar-thumb {
            background-color: #ced4da;
            border-radius: 4px;
        }

        .select2-results__options::-webkit-scrollbar-track {
            background: transparent;
        }

    /* Satır hover/seçili renkleri Bootstrap primary ile uyumlu */
    .select2-results__option--highlighted[aria-selected] {
        background-color: #0d6efd !important;
        color: #fff !important;
    }

    .select2-results__option[aria-selected="true"] {
        background-color: #e7f1ff;
    }

    /* Uzun firma adları taşmasın, ... ile kessin */
    .select2-results__option {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>


<div class="modal fade" id="DailyShipmentPlanModal" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    @Model.ModalTitle
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form method="post"
                  action="/DailyShipmentPlan/Edit"
                  data-api-base="@ViewBag.ApiBaseUrl"
                  data-jwt="@ViewBag.JwtToken">
                <div class="modal-body">

                    <div class="row g-3">

                        <input type="hidden" asp-for="Entity.RecId" />

                        <!-- TARİHİ -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Tarihi
                            </label>

                            <input type="date"
                                   asp-for="Entity.ReceiptDate"
                                   class="form-control"
                                   required />

                        </div>
                        <!-- Plan  KODU -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Sevkiyat No
                            </label>

                            <input type="text"
                                   asp-for="Entity.ShipmentNo"
                                   class="form-control"
                                   placeholder="Sevkiyat No giriniz" required />
                            
                        </div>

                        <!-- FİRMA KODU -->
                        <div class="col-md-4">
                            <label class="form-label">Cari Kodu</label>
                            <input type="text"
                                   asp-for="Entity.CompanyCode"
                                   id="txtCompanyCode"
                                   class="form-control"
                                   readonly
                                   placeholder="Cari seçilince otomatik dolar" />
                        </div>

                        <!-- FİRMA ADI -->
                        <div class="col-md-8">
                            <label class="form-label">Cari Hesap Adı</label>
                            <select id="ddlCompany" class="form-select" style="width:100%;" required>
                                <option value="">Cari Seçiniz</option>
                            </select>
                            <input type="hidden" asp-for="Entity.CompanyName" id="hdnCompanyName" />
                        </div>

                        <!-- ÜLKE -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Ülke
                            </label>

                            <input type="text"
                                   asp-for="Entity.Country"
                                   class="form-control"
                                   placeholder="Ülke giriniz" required />

                        </div>

                        <!-- ŞEHİR -->
                        <div class="col-md-4">
                            <label class="form-label">Şehir</label>
                            <select asp-for="Entity.City" id="ddlCity" class="form-select" required disabled>
                                <option value="">Önce Cari Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">İlçe</label>
                            <select asp-for="Entity.District" id="ddlDistrict" class="form-select" required disabled>
                                <option value="">Önce Şehir Seçiniz</option>
                            </select>
                        </div>

                        <!-- ADRES -->
                        <div class="col-md-4">
                            <label class="form-label">Kayıtlı Adresler</label>
                            <select id="ddlAddress" class="form-select" disabled>
                                <option value="">Önce İlçe Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label">Adres</label>
                            <textarea asp-for="Entity.Address" id="txtAddress" required
                                      class="form-control" rows="2"
                                      placeholder="Adres giriniz"></textarea>
                        </div>

                        <!-- VARDİYA -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Vardiya
                            </label>

                            <select asp-for="Entity.ShiftId"
                                    asp-items="ViewBag.Shifts"
                                    class="form-select"
                                    required>

                                <option value="">
                                    Vardiya Seçiniz
                                </option>

                            </select>

                        </div>

                        <!-- DURUM -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Durum
                            </label>

                            <select asp-for="Entity.InUse"
                                    class="form-select">

                                <option value="1">Aktif</option>
                                <option value="0">Pasif</option>

                            </select>

                        </div>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        İptal

                    </button>

                    <button type="submit"
                            class="btn btn-success px-4">

                        <ion-icon name="save-outline"
                                  class="me-1">
                        </ion-icon>

                        @(Model.IsEdit ? "Güncelle" : "Kaydet")

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>