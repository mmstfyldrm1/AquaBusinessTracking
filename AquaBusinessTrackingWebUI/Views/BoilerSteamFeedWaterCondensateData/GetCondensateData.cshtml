@using DTOLayer.Dtos.BoilerSteamFeedWaterCondensateDataDtos

@{
    ViewData["Title"] = "GetCondensateData";
    Layout = "~/Views/_UserLayout/Index.cshtml";

    var controller = "BoilerSteamFeedWaterCondensateData/GetCondensateData";
    int counter = 1;
}

@model List<BoilerSteamFeedWaterCondensateDataDto>

<div class="d-flex justify-content-between align-items-center mb-3">

    <h6 class="mb-0 text-uppercase">
        Kazan Buhar-Besi Suyu-Kondens Takip Sistemi
    </h6>

    <a asp-controller="UserDashboard"
       asp-action="AddFavorite"
       asp-route-url="@controller"
       class="btn btn-light btn-sm border rounded-pill px-3">

        <i class="bx bx-star text-warning me-1"></i>
        Favorilere Ekle

    </a>

</div>


<div class="card">

    <div class="card-body">

        <div class="table-responsive">

            <table id="example2"
                   class="table table-striped table-bordered align-middle">

                <thead>

                    <tr>
                        <th>#</th>
                        <th>Tarih</th>
                        <th>Buhar</th>
                        <th>Besi Suyu</th>
                        <th>KM2 Kondens</th>
                        <th>HVAC</th>
                        <th>Vardiya</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th class="text-center">İşlemler</th>
                    </tr>

                </thead>


                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@counter</td>

                            <td>
                                @item.ReceiptDate.ToString("dd.MM.yyyy")
                            </td>

                            <td>
                                @item.Boil
                            </td>

                            <td>
                                @item.FeedWater
                            </td>

                            <td>
                                @item.KM2Kodens
                            </td>

                            <td>
                                @item.Hvac
                            </td>

                            <td>
                                @item.ShiftName
                            </td>

                            <td>
                                @(item.InsertDate.HasValue
                                                            ? item.InsertDate.Value.ToString("dd.MM.yyyy HH:mm")
                                                            : "-")
                        </td>

                            <td>
                                @item.CreatedByName
                            </td>


                            <!-- İŞLEMLER -->
                            <td class="text-center">

                                <div class="d-flex justify-content-center align-items-center gap-3">

                                    <!-- Güncelle -->
                                    <a href="javascript:void(0);"
                                       class="table-action text-warning"
                                       onclick="openModal(@item.RecId)"
                                       title="Güncelle">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>


                                    <!-- Sil -->
                                    <form method="post"
                                          asp-action="Delete"
                                          asp-route-id="@item.RecId"
                                          style="display:inline;">

                                        <button type="submit"
                                                class="table-action delete-action"
                                                onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');"
                                                title="Sil">

                                            <ion-icon name="trash-outline"></ion-icon>

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                                        counter++;
                    }

                </tbody>


                <tfoot>

                    <tr>
                        <th>#</th>
                        <th>Tarih</th>
                        <th>Buhar</th>
                        <th>Besi Suyu</th>
                        <th>KM2 Kondens</th>
                        <th>HVAC</th>
                        <th>Vardiya</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th class="text-center">İşlemler</th>
                    </tr>

                </tfoot>

            </table>

        </div>


        <!-- YENİ KAYIT -->
        <div class="mt-3">

            <button class="btn btn-primary shadow-sm"
                    onclick="openModal()">

                <ion-icon name="add-circle-outline"
                          class="me-1"></ion-icon>

                Yeni Kayıt Ekle

            </button>

        </div>

    </div>

</div>


<div id="modalContainer"></div>


<style>

    /* İşlem ikonları */

    .table-action {
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: none;
        background: transparent;
        padding: 0;
        cursor: pointer;
        transition: all .2s ease;
    }


        .table-action:hover {
            transform: translateY(-1px);
        }


        /* Güncelle */

        .table-action.text-warning {
            color: #f0ad00 !important;
        }

            .table-action.text-warning:hover {
                color: #d89400 !important;
            }


    /* Sil */

    .delete-action {
        color: #dc3545;
    }

        .delete-action:hover {
            color: #b02a37;
        }

</style>


<script>

    function openModal(id = null) {

        const url = id
            ? `/BoilerSteamFeedWaterCondensateData/Edit/${id}`
            : `/BoilerSteamFeedWaterCondensateData/Edit`;


        fetch(url)

            .then(response => {

                if (!response.ok) {
                    throw new Error("Modal yüklenemedi.");
                }

                return response.text();

            })

            .then(html => {

                document.getElementById("modalContainer").innerHTML = html;


                const modalEl =
                    document.getElementById(
                        "boilerSteamFeedWaterCondensateDataModal"
                    );


                if (!modalEl) {

                    console.error(
                        "boilerSteamFeedWaterCondensateDataModal bulunamadı."
                    );

                    return;
                }


                const modal =
                    new bootstrap.Modal(modalEl);


                modal.show();


                const form =
                    modalEl.querySelector("form");


                if (!form) {
                    return;
                }


                form.addEventListener("submit", function (e) {

                    e.preventDefault();


                    fetch(
                        "/BoilerSteamFeedWaterCondensateData/Edit",
                        {
                            method: "POST",
                            body: new FormData(this)
                        }
                    )

                    .then(response => {

                        if (!response.ok) {
                            throw new Error("Kayıt işlemi başarısız.");
                        }

                        return response;

                    })

                    .then(() => {

                        modal.hide();

                        location.reload();

                    })

                    .catch(error => {

                        console.error(error);

                        alert("Kayıt sırasında bir hata oluştu.");

                    });

                });

            })

            .catch(error => {

                console.error(error);

                alert("Form yüklenirken bir hata oluştu.");

            });

    }

</script>