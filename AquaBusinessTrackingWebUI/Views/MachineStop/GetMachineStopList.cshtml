@using DTOLayer.Dtos.MachineStopDtos

@{
    ViewData["Title"] = "GetMachineStopList";
    Layout = "~/Views/_UserLayout/Index.cshtml";
    int counter = 0;
    var controller = "MachineStop/GetMachineStopList";
    string actionName = string.Empty;

    if (ViewBag.FavMenu == 1)
    {
        actionName = "DeleteFavorite";
    }
    else
    {
        actionName = "AddFavorite";
    }

}
@model List<MachineStopDto>
<style>
    .table-action {
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

        .table-action:hover {
            transform: translateY(-1px);
        }

    .delete-action {
        border: none;
        background: none;
        padding: 0;
    }

    .table-action.text-info:hover {
        color: #087f8c !important;
    }

    .table-action.text-warning:hover {
        color: #d39e00 !important;
    }

    .delete-action:hover {
        color: #b02a37 !important;
    }
</style>
<div class="d-flex justify-content-between align-items-center">
    <h6 class="mb-0 text-uppercase">Makine Duruş Takip Sistemi</h6>
    <a asp-controller="UserDashboard"
       asp-action="@actionName"
       asp-route-url="@controller"
       class="btn btn-light btn-sm border rounded-pill px-3">
        <i class="bx @(ViewBag.FavMenu == 1 ? "bxs-star text-warning" : "bx-star text-secondary") me-1"></i>

        @(ViewBag.FavMenu == 1 ? "Favorilerde" : "Favorilere Ekle")
    </a>
</div>

<hr />

<div class="card">
    <div class="card-body">

        <div class="table-responsive">
            <table id="example2" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Başlangıç Saati</th>
                        <th>Bitiş Saati</th>
                        <th>Süre Kaybı (dk)</th>
                        <th>Kopma Yeri</th>
                        <th>Duruş Nedeni</th>
                        <th>Ekipman</th>
                        <th>Açıklama</th>
                        <th>Vardiya</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th>Güncelleme Tarihi</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@counter</td>

                            <td>
                                @(item.StartTime?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>

                            <td>
                                @(item.EndTime?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>

                            <td>
                                @(item.DowntimeDuration ?? 0)
                            </td>

                            <td>
                                @item.PointofRupture
                            </td>

                            <td>
                                @item.ReasonDisconnection
                            </td>

                            <td>
                                @item.Equipment
                            </td>
                            <td>
                                @item.Explanation
                            </td>

                            <td>
                                @item.ShiftName
                            </td>

                            <td>
                                @(item.InsertDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>

                            <td>
                                @item.CreatedByName
                            </td>

                            <td>
                                @(item.UpdateDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Güncelle -->
                                    <a href="javascript:void(0);"
                                       class="table-action text-warning"
                                       onclick="openModal(@item.RecId)"
                                       title="Güncelle">
                                        <ion-icon name="pencil-outline"></ion-icon>
                                    </a>

                                    <!-- Sil -->
                                    <form method="post"
                                          asp-action="Delete"
                                          asp-route-id="@item.RecId"
                                          style="display:inline;">

                                        <button type="submit"
                                                class="table-action delete-action"
                                                onclick="return confirm('Silinsin mi?');"
                                                title="Sil">
                                            <ion-icon name="trash-outline"></ion-icon>
                                        </button>

                                    </form>

                                </div>
                            </td>

                        </tr>

                        counter++;
                    }

                </tbody>

                <tfoot>
                    <tr>
                        <th>#</th>
                        <th>Başlangıç Saati</th>
                        <th>Bitiş Saati</th>
                        <th>Süre Kaybı (dk)</th>
                        <th>Kopma Yeri</th>
                        <th>Duruş Nedeni</th>
                        <th>Ekipman</th>
                        <th>Açıklama</th>
                        <th>Vardiya</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th>Güncelleme Tarihi</th>
                        <th>İşlemler</th>
                    </tr>
                </tfoot>

            </table>
        </div>

        <button class="btn btn-primary shadow-sm mt-3"
                onclick="openModal()">

            <ion-icon name="add-circle-outline"></ion-icon>
            Yeni Kayıt Ekle

        </button>

    </div>
</div>

<div id="modalContainer"></div>


<script>
    function openModal(id = null) {

        const url = id
            ? `/MachineStop/Edit/${id}`
            : `/MachineStop/Edit`;

        fetch(url)
            .then(r => r.text())
            .then(html => {

                document.getElementById('modalContainer').innerHTML = html;

                const modalEl = document.getElementById('machineStopModal');
                const modal = new bootstrap.Modal(modalEl);

                modal.show();


                // =====================================================
                // SELECT2
                // =====================================================

                $('#machineStopModal .select2-machine-stop').select2({
                    dropdownParent: $('#machineStopModal'),
                    width: '100%',
                    placeholder: function () {
                        return $(this).data('placeholder');
                    },
                    allowClear: true,
                    language: {
                        noResults: function () {
                            return "Sonuç bulunamadı";
                        },
                        searching: function () {
                            return "Aranıyor...";
                        }
                    }
                });


                // =====================================================
                // BAŞLANGIÇ - BİTİŞ SÜRE HESAPLAMA
                // =====================================================

                const startInput = modalEl.querySelector(
                    '[name="Entity.StartTime"]'
                );

                const endInput = modalEl.querySelector(
                    '[name="Entity.EndTime"]'
                );

                const durationInput = modalEl.querySelector(
                    '[name="Entity.DowntimeDuration"]'
                );


                function calculateDuration() {

                    if (!startInput || !endInput || !durationInput)
                        return;

                    if (!startInput.value || !endInput.value) {
                        durationInput.value = '';
                        return;
                    }


                    const start = new Date(startInput.value);
                    const end = new Date(endInput.value);


                    // Dakika cinsinden fark
                    const differenceMs = end - start;

                    const differenceMinutes =
                        differenceMs / (1000 * 60);


                    // Bitiş başlangıçtan küçükse
                    if (differenceMinutes < 0) {

                        durationInput.value = '';

                        return;
                    }


                    // Dakikayı yaz
                    durationInput.value =
                        differenceMinutes.toFixed(2);
                }


                // Başlangıç değiştiğinde
                startInput?.addEventListener(
                    'change',
                    calculateDuration
                );


                // Bitiş değiştiğinde
                endInput?.addEventListener(
                    'change',
                    calculateDuration
                );


                // Edit ekranında mevcut değerler varsa
                calculateDuration();


                // =====================================================
                // FORM SUBMIT
                // =====================================================

                const form = modalEl.querySelector('form');

                form.addEventListener('submit', function (e) {

                    e.preventDefault();

                    fetch('/MachineStop/Edit', {
                        method: 'POST',
                        body: new FormData(this)
                    })
                    .then(r => {

                        if (r.ok) {

                            modal.hide();

                            location.reload();
                        }

                    });

                });

            });
    }
</script>
