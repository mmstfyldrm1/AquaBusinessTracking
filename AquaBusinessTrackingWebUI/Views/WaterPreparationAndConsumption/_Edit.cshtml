@using DTOLayer.Dtos.WaterPreparationAndConsumptionDtos

@model ModalViewModel<WaterPreparationAndConsumptionDto>

<style>
    .select2-container {
        width: 100% !important;
    }

        .select2-container .select2-selection--single {
            height: calc(2.25rem + 2px) !important;
            padding: .375rem .75rem;
            border: 1px solid #ced4da !important;
            border-radius: .375rem !important;
        }

        .select2-container .select2-selection__rendered {
            line-height: 1.5 !important;
            padding-left: 0 !important;
        }

        .select2-container .select2-selection__arrow {
            height: calc(2.25rem + 2px) !important;
        }
</style>


<div class="modal fade" id="waterPreparationAndConsumptionModal" tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    @Model.ModalTitle
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form method="post"
                  action="/WaterPreparationAndConsumption/Edit">

                <div class="modal-body">

                    <div class="row g-3">


                        <input type="hidden"
                               asp-for="Entity.RecId" />


                        <!-- STOK KODU -->
                        <div class="col-md-6">

                            <label class="form-label">
                               Fiş Tarihi
                            </label>

                            <input type="date" required
                                   asp-for="Entity.ReceiptDate"
                                   class="form-control"
                                   placeholder="" />

                        </div>


                        <!-- STOK KODU -->
                        <div class="col-md-6">
                            <label class="form-label">Stok Kodu</label>

                            <select asp-for="Entity.InventoryCode" required
                                    id="InventoryCode"
                                    class="form-select inventory-select">

                                <option value="">Seçiniz</option>

                                @foreach (var item in ViewBag.InventoryList)
                                {
                                    <option value="@item.Value" data-name="@item.Text">
                                        @item.Value
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Stok Adı</label>

                            <input type="text"
                                   asp-for="Entity.InventoryName"
                                   id="InventoryName"
                                   class="form-control"
                                   placeholder="Stok adı giriniz" />
                        </div>

                   
                        <!-- GELEN MİKTAR -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Gelen Miktar
                            </label>

                            <input type="number" required
                                   asp-for="Entity.IncomingQuantity"
                                   class="form-control"
                                   placeholder="Gelen miktar giriniz"
                                   step="0.01" />

                        </div>

                        <!-- TÜKETİLEN MİKTAR -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Tüketilen Miktar
                            </label>

                            <input type="number" required
                                   asp-for="Entity.ConsumedQuantity"
                                   class="form-control"
                                   placeholder="Tüketilen miktar giriniz"
                                   step="0.01" />

                        </div>

                        <!-- KALAN MİKTAR (ReadOnly) -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Kalan Miktar
                            </label>

                            <input type="number"
                                   asp-for="Entity.RemainingQuantity"
                                   class="form-control"
                                   placeholder="Kalan miktarı giriniz"
                                   readonly
                                   step="0.01"
                                    />

                        </div>

                        <!-- Stok MİKTAR (ReadOnly) -->
                        <div class="col-md-6">

                            <label class="form-label">
                               Stok
                            </label>

                            <input type="number" required
                                   asp-for="Entity.CurrentStock"
                                   class="form-control"
                                   placeholder="Güncel stok miktarı giriniz"
                                   step="0.01" />

                        </div>





                        <!-- VARDIYA -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Vardiya
                            </label>

                            <select asp-for="Entity.ShiftId" required
                                    asp-items="ViewBag.Shifts"
                                    class="form-select">

                                <option value="">
                                    Vardiya Seçiniz
                                </option>

                            </select>

                        </div>

                        <!-- AKTİF/PASİF -->
                        <div class="col-md-6">

                            <label class="form-label">
                                Durum
                            </label>

                            <select asp-for="Entity.InUse"
                                    class="form-select">

                                <option value="1">Aktif</option>
                                <option value="0">Pasif</option>

                            </select>

                        </div>



                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-light"
                                data-bs-dismiss="modal">

                            İptal

                        </button>

                        <button type="submit"
                                class="btn btn-success px-4">

                            <ion-icon name="save-outline"
                                      class="me-1">
                            </ion-icon>

                            @(Model.IsEdit ? "Güncelle" : "Kaydet")

                        </button>

                    </div>

            </form>

        </div>

    </div>

</div>