@using System.Globalization
@using System.Security.Claims

@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/_UserLayout/Index.cshtml";

    var userName = User.Identity?.Name ?? "Kullanıcı";
    var culture = new CultureInfo("tr-TR");
    var now = DateTime.Now;

    var day = culture.TextInfo.ToTitleCase(
        now.ToString("dddd", culture)
    );

    var date = now.ToString("dd MMMM yyyy", culture);
    var time = now.ToString("HH:mm");
}

<style>

    /* Dashboard Header */

    .dashboard-header {
        padding: 10px 2px 24px;
        border-bottom: 1px solid #e9ecef;
    }

    .dashboard-welcome {
        font-size: 1.45rem;
        font-weight: 600;
        color: #212529;
        margin-bottom: 5px;
    }

    .dashboard-description {
        font-size: .88rem;
        color: #6c757d;
    }

    .dashboard-user-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f4f6f8;
        color: #495057;
        border-radius: 10px;
        font-size: 21px;
    }

    .dashboard-time {
        text-align: right;
        padding-left: 30px;
        border-left: 1px solid #e9ecef;
    }

    .dashboard-time-value {
        font-size: 1.15rem;
        font-weight: 600;
        color: #212529;
    }

    .dashboard-date-value {
        font-size: .78rem;
        color: #868e96;
        margin-top: 2px;
    }


    /* Section */

    .dashboard-section {
        padding-top: 26px;
    }

    .section-header {
        margin-bottom: 15px;
    }

    .section-title {
        font-size: .95rem;
        font-weight: 600;
        color: #343a40;
    }

    .section-description {
        font-size: .78rem;
        color: #868e96;
        margin-top: 3px;
    }


    /* Favoriler */

    .favorite-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .favorite-item {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 14px;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        color: #343a40;
        text-decoration: none;
        font-size: .84rem;
        font-weight: 500;
        transition: all .2s ease;
    }

        .favorite-item i {
            font-size: 18px;
            color: #6c757d;
        }

        .favorite-item:hover {
            border-color: #ced4da;
            background: #f8f9fa;
            color: #212529;
            transform: translateY(-1px);
        }

            .favorite-item:hover i {
                color: #f0ad00;
            }


    @@media (max-width: 576px) {

        .dashboard-time {
            margin-top: 15px;
            padding-left: 0;
            padding-top: 12px;
            border-left: 0;
            border-top: 1px solid #e9ecef;
            text-align: left;
            width: 100%;
        }
    }

</style>


<!-- Dashboard Header -->

<div class="dashboard-header">

    <div class="d-flex justify-content-between align-items-center flex-wrap">

        <div class="d-flex align-items-center">

            <div class="dashboard-user-icon me-3">
                <i class="bx bx-user"></i>
            </div>

            <div>

                <div class="dashboard-welcome">
                    Hoş Geldiniz, @userName
                </div>

                <div class="dashboard-description">
                    MES Yönetim Paneli
                    <span class="mx-1">•</span>
                    @day
                </div>

            </div>

        </div>


        <!-- Saat -->

        <div class="dashboard-time">

            <div class="dashboard-time-value">
                <i class="bx bx-time-five me-1"></i>
                @time
            </div>

            <div class="dashboard-date-value">
                @date
            </div>

        </div>

    </div>

</div>


<!-- Favoriler -->

<div class="dashboard-section">

    <div class="section-header">

        <div class="section-title">
            <i class="bx bxs-star text-warning me-1"></i>
            Favori Modüllerim
        </div>

        <div class="section-description">
            Sık kullandığınız modüllere hızlı erişim
        </div>

    </div>


    @await Component.InvokeAsync(
    "_UserDashboardFavoriteMenuComponentPartial",
        new
        {
            appUserId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value
        }
        )

</div>