@using DTOLayer.Dtos.RawMaterialIntakesDtos

@{
    ViewData["Title"] = "GetRawMaterialsList";
    Layout = "~/Views/_UserLayout/Index.cshtml";
    int counter = 0;
    var controller = "RawMaterials/GetRawMaterialsList";

    string actionName = string.Empty;

    if (ViewBag.FavMenu == 1)
    {
        actionName = "DeleteFavorite";
    }
    else
    {
        actionName = "AddFavorite";
    }

}

@model List<RawMaterialIntakesDto>
<style>
    .table-action {
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

        .table-action:hover {
            transform: translateY(-1px);
        }

    .delete-action {
        border: none;
        background: none;
        padding: 0;
    }

    .table-action.text-info:hover {
        color: #087f8c !important;
    }

    .table-action.text-warning:hover {
        color: #d39e00 !important;
    }

    .delete-action:hover {
        color: #b02a37 !important;
    }
</style>
<div class="d-flex justify-content-between align-items-center">
    <h6 class="mb-0 text-uppercase">Kantar Takip Sistemi</h6>
    <a asp-controller="UserDashboard"
       asp-action="@actionName"
       asp-route-url="@controller"
       class="btn btn-light btn-sm border rounded-pill px-3">
        <i class="bx @(ViewBag.FavMenu == 1 ? "bxs-star text-warning" : "bx-star text-secondary") me-1"></i>

        @(ViewBag.FavMenu == 1 ? "Favorilerde" : "Favorilere Ekle")
    </a>
</div>

<hr />

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="example2" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tarih</th>
                        <th>Saat</th>
                        <th>İrsaliye No</th>
                        <th>Cari</th>
                        <th>Plaka</th>
                        <th>Operatör</th>
                        <th>İrsaliye Miktarı</th>
                        <th>Dolu Ağırlık</th>
                        <th>Boş Ağırlık</th>
                        <th>Net Ağırlık</th>
                        <th>Vardiya</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@counter</td>

                            <td>@item.ReceiptDate?.ToString("dd.MM.yyyy")</td>
                            <td>@item.ScaleHours.ToString(@"hh\:mm")</td>
                            <td>@item.WaybillNo</td>
                            <td>@item.CurrentAccountName</td>
                            <td>@item.TruckPlate</td>
                            <td>@item.Operator</td>
                            <td>@item.WaybillQuantity.ToString("N2")</td>
                            <td>@item.FilledQuantity.ToString("N2")</td>
                            <td>@item.EmptyQuantity.ToString("N2")</td>
                            <td>@item.NetQuantity.ToString("N2")</td>
                            <td>@item.ShiftName</td>
                            <td>@item.InsertDate?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.CreatedByName</td>

                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Güncelle -->
                                    <a href="javascript:void(0);"
                                       class="table-action text-warning"
                                       onclick="openModal(@item.RecId)"
                                       title="Güncelle">
                                        <ion-icon name="pencil-outline"></ion-icon>
                                    </a>

                                    <!-- Sil -->
                                    <form method="post"
                                          asp-action="Delete"
                                          asp-route-id="@item.RecId"
                                          style="display:inline;">

                                        <button type="submit"
                                                class="table-action delete-action"
                                                onclick="return confirm('Silinsin mi?');"
                                                title="Sil">
                                            <ion-icon name="trash-outline"></ion-icon>
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>

                        counter++;
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th>#</th>
                        <th>Tarih</th>
                        <th>Saat</th>
                        <th>İrsaliye No</th>
                        <th>Cari</th>
                        <th>Plaka</th>
                        <th>Operatör</th>
                        <th>İrsaliye Miktarı</th>
                        <th>Dolu Ağırlık</th>
                        <th>Boş Ağırlık</th>
                        <th>Net Ağırlık</th>
                        <th>Vardiya</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th>İşlemler</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <button class="btn btn-primary shadow-sm" onclick="openModal()">
            <ion-icon name="add-circle-outline"></ion-icon>
            Yeni Kayıt Ekle
        </button>

        <a href="/RawMaterials/GetWithSearchDetails" class="btn btn-outline-secondary shadow-sm">
            <ion-icon name="document-text-outline" class="me-1"></ion-icon>
            Tüm Detayları Gör
        </a>
    </div>
</div>

<div id="modalContainer"></div>

<script>

    // MODAL AÇMA
    async function openModal(id = null) {

        const url = id
            ? `/RawMaterials/Edit/${id}`
            : `/RawMaterials/Edit`;

        try {

            const response = await fetch(url);

            if (!response.ok) {
                throw new Error('Modal yüklenemedi.');
            }

            const html = await response.text();
            const container = document.getElementById('modalContainer');
            container.innerHTML = html;

            const modalEl = document.getElementById('rawMaterialsModal');

            if (!modalEl) {
                throw new Error('rawMaterialsModal elementi bulunamadı.');
            }

            const modal = new bootstrap.Modal(modalEl);

            // FORM KAYDETME
            const form = modalEl.querySelector('form');

            if (form) {
                form.addEventListener('submit', async function (e) {
                    e.preventDefault();

                    const submitButton = form.querySelector('[type="submit"]');
                    if (submitButton) submitButton.disabled = true;

                    try {
                        const saveResponse = await fetch(form.action || '/RawMaterials/Edit', {
                            method: 'POST',
                            body: new FormData(form)
                        });

                        if (saveResponse.ok) {
                            modal.hide();
                            modalEl.addEventListener('hidden.bs.modal', function () {
                                container.innerHTML = '';
                                location.reload();
                            }, { once: true });
                        } else {
                            console.error('Kayıt hatası:', await saveResponse.text());
                            alert('Kayıt sırasında bir hata oluştu.');
                            if (submitButton) submitButton.disabled = false;
                        }
                    } catch (error) {
                        console.error(error);
                        alert('Sunucuya bağlanırken hata oluştu.');
                        if (submitButton) submitButton.disabled = false;
                    }
                });
            }

            // CARİ SELECT2
            initCompanySelect2(modalEl);

            // AĞIRLIK HESAPLAMA (Net = Dolu - Boş)
            const filled = modalEl.querySelector('#Entity_FilledQuantity');
            const empty = modalEl.querySelector('#Entity_EmptyQuantity');
            const net = modalEl.querySelector('#Entity_NetQuantity');

            if (filled && empty && net) {

                function calculateNet() {
                    const filledValue = parseFloat(filled.value.replace(',', '.')) || 0;
                    const emptyValue = parseFloat(empty.value.replace(',', '.')) || 0;
                    net.value = (filledValue - emptyValue).toFixed(2);
                }

                filled.addEventListener('input', calculateNet);
                empty.addEventListener('input', calculateNet);

                calculateNet();
            }

            modal.show();

        } catch (error) {
            console.error('Modal hatası:', error);
            alert('Form açılırken bir hata oluştu.');
        }
    }


    // CARİ SELECT2
    function initCompanySelect2(modalEl) {

        var ddlCompanyEl = modalEl.querySelector('#ddlCompany');

        if (!ddlCompanyEl) {
            return;
        }

        var formEl = modalEl.querySelector('form');
        var apiBase = (formEl.dataset.apiBase || '').replace(/\/$/, '');
        var jwtToken = formEl.dataset.jwt || '';
        var txtCompanyCode = modalEl.querySelector('#txtCompanyCode');
        var hdnCompanyName = modalEl.querySelector('#hdnCompanyName');
        var hdnCompanyRecId = modalEl.querySelector('#hdnCompanyRecId');
        var $ddlCompany = $(ddlCompanyEl);

        function apiFetch(path) {
            return fetch(`${apiBase}/DailyShipmentPlan/${path}`, {
                headers: {
                    'Authorization': `Bearer ${jwtToken}`
                }
            });
        }

        $ddlCompany.select2({
            theme: 'bootstrap-5',
            placeholder: 'Cari Seçiniz',
            width: '100%',
            dropdownParent: $(modalEl),
            allowClear: true
        });

        // Cari listesini yükle
        apiFetch('currentaccount')
            .then(function (r) { return r.json(); })
            .then(function (response) {

                var data = response.data || [];

                data.forEach(function (item) {
                    var opt = new Option(item.currentAccountName, item.recId, false, false);
                    opt.dataset.code = item.currentAccountCode;
                    opt.dataset.name = item.currentAccountName;
                    ddlCompanyEl.appendChild(opt);
                });

                $ddlCompany.trigger('change.select2');

                // Düzenleme modunda mevcut cariyi seç
                if (hdnCompanyRecId && hdnCompanyRecId.value) {
                    $ddlCompany.val(hdnCompanyRecId.value).trigger('change');
                }
            })
            .catch(function (err) {
                console.error('Cari yüklenemedi:', err);
            });

        $ddlCompany.on('change', function () {

            var recId = this.value;
            var selectedOption = this.options[this.selectedIndex];

            if (!recId) {
                if (txtCompanyCode) txtCompanyCode.value = '';
                if (hdnCompanyName) hdnCompanyName.value = '';
                if (hdnCompanyRecId) hdnCompanyRecId.value = '';
                return;
            }

            if (txtCompanyCode) txtCompanyCode.value = selectedOption.dataset.code || '';
            if (hdnCompanyName) hdnCompanyName.value = selectedOption.dataset.name || '';
            if (hdnCompanyRecId) hdnCompanyRecId.value = recId;
        });
    }

</script>
