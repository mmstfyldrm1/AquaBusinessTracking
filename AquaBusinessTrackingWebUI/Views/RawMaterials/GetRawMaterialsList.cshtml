@using DTOLayer.Dtos.RawMaterialIntakesDtos

@{
    ViewData["Title"] = "GetRawMaterialsList";
    Layout = "~/Views/_UserLayout/Index.cshtml";
    int counter = 0;
    var controller = "RawMaterials/GetRawMaterialsList";
}

@model List<RawMaterialIntakesDto>
<style>
    .table-action {
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

        .table-action:hover {
            transform: translateY(-1px);
        }

    .delete-action {
        border: none;
        background: none;
        padding: 0;
    }

    .table-action.text-info:hover {
        color: #087f8c !important;
    }

    .table-action.text-warning:hover {
        color: #d39e00 !important;
    }

    .delete-action:hover {
        color: #b02a37 !important;
    }
</style>
<div class="d-flex justify-content-between align-items-center">
    <h6 class="mb-0 text-uppercase">Kantar Takip Sistemi</h6>
    <a asp-controller="UserDashboard"
       asp-action="AddFavorite"
       asp-route-url="@controller"
       class="btn btn-light btn-sm border rounded-pill px-3">
        <i class="bx bx-star text-warning me-1"></i>
        Favorilere Ekle
    </a>
</div>

<hr />

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="example2" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Tarih</th>
                        <th>Saat</th>
                        <th>İrsaliye No</th>
                        <th>Cari</th>
                        <th>Plaka</th>
                        <th>Operatör</th>
                        <th>İrsaliye Miktarı</th>
                        <th>Dolu Ağırlık</th>
                        <th>Boş Ağırlık</th>
                        <th>Net Ağırlık</th>
                        <th>Vardiya</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@counter</td>

                            <td>@item.ReceiptDate?.ToString("dd.MM.yyyy")</td>
                            <td>@item.ScaleHours.ToString(@"hh\:mm")</td>
                            <td>@item.WaybillNo</td>
                            <td>@item.CurrentAccountName</td>
                            <td>@item.TruckPlate</td>
                            <td>@item.Operator</td>
                            <td>@item.WaybillQuantity.ToString("N2")</td>
                            <td>@item.FilledQuantity.ToString("N2")</td>
                            <td>@item.EmptyQuantity.ToString("N2")</td>
                            <td>@item.NetQuantity.ToString("N2")</td>
                            <td>@item.ShiftName</td>
                            <td>@item.InsertDate?.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.CreatedByName</td>

                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Güncelle -->
                                    <a href="javascript:void(0);"
                                       class="table-action text-warning"
                                       onclick="openModal(@item.RecId)"
                                       title="Güncelle">
                                        <ion-icon name="pencil-outline"></ion-icon>
                                    </a>

                                    <!-- Sil -->
                                    <form method="post"
                                          asp-action="Delete"
                                          asp-route-id="@item.RecId"
                                          style="display:inline;">

                                        <button type="submit"
                                                class="table-action delete-action"
                                                onclick="return confirm('Silinsin mi?');"
                                                title="Sil">
                                            <ion-icon name="trash-outline"></ion-icon>
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>

                        counter++;
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th>#</th>
                        <th>Tarih</th>
                        <th>Saat</th>
                        <th>İrsaliye No</th>
                        <th>Cari</th>
                        <th>Plaka</th>
                        <th>Operatör</th>
                        <th>İrsaliye Miktarı</th>
                        <th>Dolu Ağırlık</th>
                        <th>Boş Ağırlık</th>
                        <th>Net Ağırlık</th>
                        <th>Vardiya</th>
                        <th>Kayıt Tarihi</th>
                        <th>Kayıt Eden</th>
                        <th>İşlemler</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <button class="btn btn-primary shadow-sm" onclick="openModal()">
            <ion-icon name="add-circle-outline"></ion-icon>
            Yeni Kayıt Ekle
        </button>

        <a href="/RawMaterials/GetWithSearchDetails" class="btn btn-outline-secondary shadow-sm">
            <ion-icon name="document-text-outline" class="me-1"></ion-icon>
            Tüm Detayları Gör
        </a>
    </div>
</div>

<div id="modalContainer"></div>

<script>
    function openModal(id = null) {

        const url = id
            ? `/RawMaterials/Edit/${id}`
            : `/RawMaterials/Edit`;

        fetch(url)
            .then(r => r.text())
            .then(html => {

                document.getElementById('modalContainer').innerHTML = html;

                const modalEl = document.getElementById('rawMaterialsModal');
                const modal = new bootstrap.Modal(modalEl);

                modal.show();

                // Form
                const form = modalEl.querySelector('form');

                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    fetch('/RawMaterials/Edit', {
                        method: 'POST',
                        body: new FormData(this)
                    })
                    .then(r => {
                        if (r.ok) {
                            modal.hide();
                            location.reload();
                        }
                    });
                });

                // Ağırlık alanları
                const incoming = document.getElementById("Entity_FilledQuantity");
                const consumed = document.getElementById("Entity_EmptyQuantity");
                const remaining = document.getElementById("Entity_NetQuantity");

                function calculateRemaining() {

                    const incomingValue =
                        parseFloat(incoming.value.replace(',', '.')) || 0;

                    const consumedValue =
                        parseFloat(consumed.value.replace(',', '.')) || 0;

                    const result = incomingValue - consumedValue;

                    remaining.value = result.toFixed(2);
                }

                // Değerler değiştiğinde hesapla
                incoming.addEventListener("input", calculateRemaining);
                consumed.addEventListener("input", calculateRemaining);

                // Modal açıldığında ilk hesabı yap
                calculateRemaining();
            });
    }
</script>