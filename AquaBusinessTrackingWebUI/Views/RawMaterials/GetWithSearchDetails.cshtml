@{
    ViewData["Title"] = "Hammadde Girişleri";
    Layout = "~/Views/_UserLayout/Index.cshtml";
}

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h4 class="mb-0">
            <i class="bi bi-truck"></i> Hammadde Girişleri
        </h4>
    </div>

    <div class="card-body">

        <!-- Filtre Alanı -->
        <div class="row g-3 align-items-end mb-4">

            <div class="col-md-3">
                <label for="startDate" class="form-label fw-semibold">
                    Başlangıç Tarihi
                </label>
                <input type="date"
                       id="startDate"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <label for="endDate" class="form-label fw-semibold">
                    Bitiş Tarihi
                </label>
                <input type="date"
                       id="endDate"
                       class="form-control" />
            </div>

            <div class="col-md-3">
                <button id="btnSearch"
                        class="btn btn-primary w-100">
                    <i class="bi bi-search"></i>
                    Ara
                </button>
            </div>

            <div class="col-md-3">
                <button id="btnReset"
                        class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Sıfırla
                </button>
            </div>

        </div>

        <div id="dateWarning"
             class="alert alert-warning d-none"
             role="alert">
            Lütfen başlangıç ve bitiş tarihlerini seçin.
        </div>


        <!-- Özet -->
        <div class="row g-3 mb-4">

            <div class="col-md-3">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">
                        Toplam Kayıt
                    </div>
                    <div class="fs-4 fw-bold"
                         id="totalRecords">
                        0
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">
                        İrsaliye Miktarı
                    </div>
                    <div class="fs-4 fw-bold"
                         id="totalWaybill">
                        0
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">
                        Brüt Miktar
                    </div>
                    <div class="fs-4 fw-bold"
                         id="totalFilled">
                        0
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="border rounded p-3 bg-light">
                    <div class="text-muted small">
                        Net Miktar
                    </div>
                    <div class="fs-4 fw-bold"
                         id="totalNet">
                        0
                    </div>
                </div>
            </div>

        </div>


        <!-- Tablo -->
        <div class="table-responsive">

            <table id="rawMaterialTable"
                   class="table table-striped table-hover align-middle w-100">

                <thead class="table-light">

                    <tr>
                        <th>#</th>
                        <th>İrsaliye Tarihi</th>
                        <th>Kantar Saati</th>
                        <th>İrsaliye No</th>
                        <th>Cari Hesap</th>
                        <th>Araç Plaka</th>
                        <th>Operatör</th>
                        <th>Vardiya</th>
                        <th>İrsaliye Miktarı</th>
                        <th>Dolu</th>
                        <th>Boş</th>
                        <th>Net</th>
                        <th>Oluşturan</th>
                        <th>Kayıt Tarihi</th>
                        <th>Güncelleme Tarihi</th>
                    </tr>

                    <tr>
                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                        <th>
                            <input type="text"
                                   class="form-control form-control-sm column-filter" />
                        </th>

                    </tr>

                </thead>

                <tbody></tbody>

            </table>

        </div>

    </div>
</div>


@section Scripts {

    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.bootstrap5.min.css">

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.bootstrap5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.print.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.min.js"></script>


    <script>

        $(document).ready(function () {

            const today = new Date();

            const firstDay =
                new Date(
                    today.getFullYear(),
                    today.getMonth(),
                    1
                );


            $('#startDate').val(
                firstDay.toISOString().split('T')[0]
            );

            $('#endDate').val(
                today.toISOString().split('T')[0]
            );


            // -----------------------------
            // Format Fonksiyonları
            // -----------------------------

            function fmtDate(value) {

                if (!value)
                    return '';

                return new Date(value)
                    .toLocaleDateString('tr-TR');
            }


            function fmtTime(value) {

                if (!value)
                    return '';

                // TimeSpan JSON formatı:
                // "13:45:00"

                if (typeof value === 'string') {

                    return value.substring(0, 5);
                }

                return value;
            }


            function fmtDateTime(value) {

                if (!value)
                    return '-';

                return new Date(value)
                    .toLocaleString('tr-TR');
            }


            function fmtNumber(value) {

                return (value ?? 0)
                    .toLocaleString(
                        'tr-TR',
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );
            }


            // -----------------------------
            // DataTable
            // -----------------------------

            const table = $('#rawMaterialTable').DataTable({

                stateSave: true,

                scrollX: true,

                language: {
                    url: 'https://cdn.datatables.net/plug-ins/1.13.7/i18n/tr.json'
                },

                dom: '<"d-flex justify-content-between align-items-center mb-2"lBf>rtip',

                buttons: [

                    {
                        extend: 'excelHtml5',
                        text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                        className: 'btn btn-sm btn-outline-success'
                    },

                    {
                        extend: 'pdfHtml5',
                        text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                        className: 'btn btn-sm btn-outline-danger',
                        orientation: 'landscape'
                    },

                    {
                        extend: 'print',
                        text: '<i class="bi bi-printer"></i> Yazdır',
                        className: 'btn btn-sm btn-outline-secondary'
                    }

                ],


                columns: [

                    {
                        data: 'recId'
                    },

                    {
                        data: 'receiptDate',
                        render: fmtDate
                    },

                    {
                        data: 'scaleHours',
                        render: fmtTime
                    },

                    {
                        data: 'waybillNo'
                    },

                    {
                        data: 'currentAccountName'
                    },

                    {
                        data: 'truckPlate'
                    },

                    {
                        data: 'operator'
                    },

                    {
                        data: 'shiftName',
                        defaultContent: '-'
                    },

                    {
                        data: 'waybillQuantity',
                        render: fmtNumber,
                        className: 'text-end'
                    },

                    {
                        data: 'filledQuantity',
                        render: fmtNumber,
                        className: 'text-end'
                    },

                    {
                        data: 'emptyQuantity',
                        render: fmtNumber,
                        className: 'text-end'
                    },

                    {
                        data: 'netQuantity',
                        render: fmtNumber,
                        className: 'text-end fw-bold'
                    },

                    {
                        data: 'createdByName',
                        defaultContent: '-'
                    },

                    {
                        data: 'insertDate',
                        render: fmtDateTime
                    },

                    {
                        data: 'updateDate',
                        render: fmtDateTime
                    }

                ],

                order: [
                    [1, 'desc']
                ],

                pageLength: 25,

                lengthMenu: [
                    10,
                    25,
                    50,
                    100
                ]

            });


            // -----------------------------
            // Kolon Filtreleri
            // -----------------------------

            $('.column-filter').on(
                'keyup change',
                function () {

                    const idx =
                        $('.column-filter').index(this);

                    table
                        .column(idx)
                        .search(this.value)
                        .draw();

                }
            );


            // -----------------------------
            // Arama
            // -----------------------------

            $('#btnSearch').on(
                'click',
                function () {

                    const startDate =
                        $('#startDate').val();

                    const endDate =
                        $('#endDate').val();


                    if (!startDate || !endDate) {

                        $('#dateWarning')
                            .removeClass('d-none');

                        return;
                    }


                    $('#dateWarning')
                        .addClass('d-none');


                    if (
                        new Date(startDate) >
                        new Date(endDate)
                    ) {

                        alert(
                            'Başlangıç tarihi bitiş tarihinden büyük olamaz.'
                        );

                        return;
                    }


                    loadData(
                        startDate,
                        endDate
                    );

                }
            );


            // -----------------------------
            // Reset
            // -----------------------------

            $('#btnReset').on(
                'click',
                function () {

                    $('#startDate').val(
                        firstDay.toISOString().split('T')[0]
                    );

                    $('#endDate').val(
                        today.toISOString().split('T')[0]
                    );


                    $('.column-filter').val('');

                    table
                        .columns()
                        .search('')
                        .draw();


                    loadData(
                        $('#startDate').val(),
                        $('#endDate').val()
                    );

                }
            );


            // -----------------------------
            // Özet
            // -----------------------------

            function updateSummary(data) {

                const totalWaybill =
                    data.reduce(
                        (sum, r) =>
                            sum + (r.waybillQuantity || 0),
                        0
                    );


                const totalFilled =
                    data.reduce(
                        (sum, r) =>
                            sum + (r.filledQuantity || 0),
                        0
                    );


                const totalNet =
                    data.reduce(
                        (sum, r) =>
                            sum + (r.netQuantity || 0),
                        0
                    );


                $('#totalRecords')
                    .text(data.length);


                $('#totalWaybill')
                    .text(fmtNumber(totalWaybill));


                $('#totalFilled')
                    .text(fmtNumber(totalFilled));


                $('#totalNet')
                    .text(fmtNumber(totalNet));

            }


            // -----------------------------
            // Data Getir
            // -----------------------------

            function loadData(
                startDate,
                endDate
            ) {

                table
                    .clear()
                    .draw();


                $.ajax({

                    url: '/RawMaterials/GetWithSearchDetailsJson',

                    type: 'GET',

                    data: {
                        startDate: startDate,
                        endDate: endDate
                    },


                    beforeSend: function () {

                        $('#btnSearch')
                            .prop('disabled', true)
                            .html(
                                '<span class="spinner-border spinner-border-sm"></span> Aranıyor...'
                            );

                    },


                    success: function (data) {

                        table
                            .rows
                            .add(data)
                            .draw();


                        updateSummary(data);

                    },


                    error: function (
                        xhr,
                        status,
                        err
                    ) {

                        console.error(
                            'AJAX hatası:',
                            xhr.status,
                            xhr.responseText
                        );


                        alert(
                            'Veriler alınırken bir hata oluştu.'
                        );

                    },


                    complete: function () {

                        $('#btnSearch')
                            .prop('disabled', false)
                            .html(
                                '<i class="bi bi-search"></i> Ara'
                            );

                    }

                });

            }


            // -----------------------------
            // İlk Yükleme
            // -----------------------------

            loadData(
                $('#startDate').val(),
                $('#endDate').val()
            );

        });

    </script>
}

