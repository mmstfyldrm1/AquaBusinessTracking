@using DTOLayer.Dtos.UserDtos

@model List<GetUserDto>

@{
    ViewData["Title"] = "UserList";
    Layout = "~/Views/_UserLayout/Index.cshtml";
}

<style>
    .table-action {
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

        .table-action:hover {
            transform: translateY(-1px);
        }

    .delete-action {
        border: none;
        background: none;
        padding: 0;
    }

    .table-action.text-info:hover {
        color: #087f8c !important;
    }

    .table-action.text-warning:hover {
        color: #d39e00 !important;
    }

    .delete-action:hover {
        color: #b02a37 !important;
    }
</style>

<h6 class="mb-0 text-uppercase">Kullanıcı Listesi</h6>
<hr />

<div class="card">
    <div class="card-body">
        <div class="table-responsive">

            <table id="example2" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Profil</th>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Kullanıcı Adı</th>
                        <th>Email</th>
                        <th>Telefon</th>
                        <th>Departman</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int counter = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@counter</td>

                            <td class="text-center">
                                <img src="@item.CoverImgUrl"
                                     style="width:40px;height:40px;border-radius:50%;object-fit:cover;" />
                            </td>

                            <td>@item.Name</td>
                            <td>@item.SurName</td>
                            <td>@item.UserName</td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.DepartmentName</td>

                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Güncelle -->
                                    <a href="javascript:void(0);"
                                       class="table-action text-warning"
                                       onclick="openModal(@item.Id)"
                                       title="Güncelle">
                                        <ion-icon name="pencil-outline"></ion-icon>
                                    </a>

                                    <!-- Sil -->
                                    <form method="post"
                                          asp-action="DeleteUser"
                                          asp-route-id="@item.Id"
                                          style="display:inline;">

                                        <button type="submit"
                                                class="table-action delete-action"
                                                onclick="return confirm('Silinsin mi?');"
                                                title="Sil">
                                            <ion-icon name="trash-outline"></ion-icon>
                                        </button>

                                    </form>

                                </div>
                            </td>
                        </tr>

                        counter++;
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th>#</th>
                        <th>Profil</th>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Kullanıcı Adı</th>
                        <th>Email</th>
                        <th>Telefon</th>
                        <th>Departman</th>
                        <th>İşlemler</th>
                    </tr>
                </tfoot>
            </table>

        </div>
    </div>
</div>

<div id="modalContainer"></div>

<script>
       function openModal(id = null) {
        const url = id
            ? `/Settings/Edit/${id}`
            : `/Settings/Add`;

        fetch(url)
            .then(r => r.text())
            .then(html => {
                document.getElementById('modalContainer').innerHTML = html;


                const modalEl = document.getElementById('userModal');
                const modal = new bootstrap.Modal(modalEl);

                // Modal DOM'a yazıldıktan sonra event ekle
                modalEl.addEventListener('shown.bs.modal', function () {
                    document.getElementById('userForm').addEventListener('submit', function(e) {
                        e.preventDefault();
                       
                        fetch(this.action, {
                            method: 'POST',
                            body: new FormData(this)
                        })
                        .then(r => {
                            if (r.ok) {
                                modal.hide();
                                location.reload();
                            }
                        });
                    });
                }, { once: true }); // sadece bir kere çalışsın

                modal.show();
            });
    }
</script>

