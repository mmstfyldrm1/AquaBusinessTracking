@using DTOLayer.Dtos.ElectricDtos.ElectricShiftDtos

@{
    ViewData["Title"] = "GetElectricShiftWorking";
    Layout = "~/Views/_UserLayout/Index.cshtml";
    int counter = 1;
    var controller = "ElectricShiftWorking/GetElectricShiftWorking";
}
@model List<ElectricShiftWorkDto>

<style>
    .table-action {
        font-size: 18px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

        .table-action:hover {
            transform: translateY(-1px);
        }

    .delete-action {
        border: none;
        background: none;
        padding: 0;
    }

    .table-action.text-info:hover {
        color: #087f8c !important;
    }

    .table-action.text-warning:hover {
        color: #d39e00 !important;
    }

    .delete-action:hover {
        color: #b02a37 !important;
    }
</style>

<div class="d-flex justify-content-between align-items-center">
    <h6 class="mb-0 text-uppercase">Vardiya Takip Sistemi</h6>

    <a asp-controller="UserDashboard"
       asp-action="AddFavorite"
       asp-route-url="@controller"
       class="btn btn-light btn-sm border rounded-pill px-3">
        <i class="bx bx-star text-warning me-1"></i>
        Favorilere Ekle
    </a>
</div>

<hr />

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table id="example2" class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Fiş Tarihi</th>
                        <th>Vardiya</th>
                        <th>Kullanıcı</th>
                         <th>Kayıt Tarihi</th>
                        <th>Güncelleme Tarihi</th>
                        <th>İşlemler</th>
                        
                    </tr>
                </thead>

                <tbody>


                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @counter
                            </td>

                            <td>
                                @item.ReceiptDate.ToString("dd.MM.yyyy")
                            </td>

                            <td>
                                @item.ShiftName
                            </td>

                            <td>
                                @item.CreatedByName
                            </td>

                            <td>
                                @(item.InsertDate.HasValue
                                                            ? item.InsertDate.Value.ToString("dd.MM.yyyy HH:mm")
                                                            : "-")
                                                              </td>

                            <td>
                                @(item.UpdateDate.HasValue
                                                            ? item.UpdateDate.Value.ToString("dd.MM.yyyy HH:mm")
                                                            : "-")
                        </td>

                                                <!-- İşlemler -->
                                                <td class="text-center">

                                                    <div class="d-flex justify-content-center align-items-center gap-3">

                                                        <!-- Güncelle -->
                                                        <a href="javascript:void(0);"
                                                           class="table-action text-warning"
                                                           onclick="openModal(@item.RecId)"
                                                           title="Güncelle">

                                                            <ion-icon name="pencil-outline"></ion-icon>

                                                        </a>


                                                        <!-- Sil -->
                                                        <form method="post"
                                                              asp-action="DeleteShiftWork"
                                                              asp-route-id="@item.RecId"
                                                              style="display:inline;">

                                                            <button type="submit"
                                                                    class="table-action delete-action"
                                                                    onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');"
                                                                    title="Sil">

                                                                <ion-icon name="trash-outline"></ion-icon>

                                                            </button>

                                                        </form>

                                                    </div>

                                                </td>

                                            </tr>

                                            counter++;
                    }
                </tbody>

                <tfoot>
                    <tr>
                        <th>#</th>
                        <th>Fiş Tarihi</th>
                        <th>Vardiya</th>
                        <th>Kullanıcı</th>
                        <th>Kayıt Tarihi</th>
                        <th>Güncelleme Tarihi</th>
                        <th>İşlemler</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <button class="btn btn-primary shadow-sm" onclick="openModal()">
            <ion-icon name="add-circle-outline"></ion-icon>
            Yeni Kayıt
        </button>
    </div>
</div>

<div id="modalContainer"></div>


<script>
           function openModal(id = null) {
        const url = id
            ? `/ElectricShiftWorking/Edit/${id}`
            : `/ElectricShiftWorking/Edit`;

        fetch(url)
            .then(r => r.text())
            .then(html => {
                document.getElementById('modalContainer').innerHTML = html;
                const modalEl = document.getElementById('electricShiftModal');
                const modal = new bootstrap.Modal(modalEl);

                modal.show();

                const form = modalEl.querySelector('form');
                form.addEventListener('submit', function (e) {
                    e.preventDefault();

                    fetch('/ElectricShiftWorking/Edit', {
                        method: 'POST',
                        body: new FormData(this)
                    })
                    .then(r => {
                        if (r.ok) {
                            modal.hide();
                            location.reload();
                        }
                    });
                });
            });
    }
</script>





