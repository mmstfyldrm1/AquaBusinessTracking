@using DTOLayer.Dtos.ShipmentOrderPlan
@using DTOLayer.Dtos.ShipmentOrderPlanDtos.ShipmentOrderPlanDetailDtos
@using AquaBusinessTrackingWebUI.Models
@using AquaBusinessTrackingWebUI.Controllers
@model ModalViewModel<ShipmentOrderPlanEditVm>

<style>

    #shipmentOrderPlanModal .select2-container {
        width: 100% !important;
    }

        /* Select2 ana kutusu */
        #shipmentOrderPlanModal .select2-container .select2-selection--single {
            height: 38px !important;
            min-height: 38px !important;
            border: 1px solid #ced4da !important;
            border-radius: 0.375rem !important;
            display: flex !important;
            align-items: center !important;
            padding: 0 0.75rem !important;
            background-color: #fff !important;
        }

            /* Seçili cari yazısı */
            #shipmentOrderPlanModal
            .select2-container
            .select2-selection--single
            .select2-selection__rendered {
                line-height: normal !important;
                padding: 0 !important;
                color: #212529 !important;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            /* Sağdaki ok */
            #shipmentOrderPlanModal
            .select2-container
            .select2-selection--single
            .select2-selection__arrow {
                height: 36px !important;
                right: 8px !important;
            }



    #shipmentOrderPlanModal
    .select2-container--focus
    .select2-selection--single,
    #shipmentOrderPlanModal
    .select2-container--open
    .select2-selection--single {
        border-color: #86b7fe !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25) !important;
    }



    .select2-container--open .select2-dropdown {
        z-index: 99999 !important;
        border: 1px solid #ced4da !important;
        border-radius: 0.375rem !important;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
        background-color: #fff !important;
        overflow: hidden !important;
    }



    .select2-container--open .select2-search--dropdown {
        padding: 0.5rem !important;
        background-color: #fff !important;
    }

        .select2-container--open
        .select2-search--dropdown
        .select2-search__field {
            width: 100% !important;
            height: 36px !important;
            border: 1px solid #ced4da !important;
            border-radius: 0.375rem !important;
            padding: 0.375rem 0.75rem !important;
            outline: none !important;
        }

            .select2-container--open
            .select2-search--dropdown
            .select2-search__field:focus {
                border-color: #86b7fe !important;
                box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15) !important;
            }

    .select2-results__options {
        max-height: 260px !important;
        overflow-y: auto !important;
        overflow-x: hidden !important;
    }


        .select2-results__options::-webkit-scrollbar {
            width: 8px;
        }

        .select2-results__options::-webkit-scrollbar-thumb {
            background-color: #ced4da;
            border-radius: 4px;
        }

        .select2-results__options::-webkit-scrollbar-track {
            background: transparent;
        }

    .select2-results__option {
        padding: 8px 12px !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Hover */
    .select2-results__option--highlighted {
        background-color: #0d6efd !important;
        color: #fff !important;
    }

    /* Seçili */
    .select2-results__option[aria-selected="true"] {
        background-color: #e7f1ff;
    }

    /* Seçili + hover */
    .select2-results__option--highlighted[aria-selected="true"] {
        background-color: #0d6efd !important;
        color: #fff !important;
    }

    #shipmentOrderPlanModal {
        z-index: 1055;
    }

        #shipmentOrderPlanModal .modal-dialog {
            max-width: 1140px;
            margin-top: 1.75rem;
            margin-bottom: 1.75rem;
        }

        #shipmentOrderPlanModal .modal-content {
            max-height: calc(100vh - 30px);
            overflow: hidden;
        }

        #shipmentOrderPlanModal .modal-body {
            overflow-y: auto !important;
            overflow-x: hidden !important;
            max-height: calc(100vh - 170px);
        }

            #shipmentOrderPlanModal .modal-body::-webkit-scrollbar {
                width: 8px;
            }

            #shipmentOrderPlanModal .modal-body::-webkit-scrollbar-thumb {
                background-color: #ced4da;
                border-radius: 4px;
            }

            #shipmentOrderPlanModal .modal-body::-webkit-scrollbar-track {
                background: transparent;
            }


    body > .select2-container {
        z-index: 99999 !important;
    }

        body > .select2-container .select2-dropdown {
            z-index: 99999 !important;
        }
</style>


<div class="modal fade" id="shipmentOrderPlanModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">@Model.ModalTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form method="post" action="/ShipmentOrderPlan/Edit" id="shipmentOrderPlanForm"
                  data-api-base="@ViewBag.ApiBaseUrl" data-jwt="@ViewBag.JwtToken">
                <div class="modal-body">

                    <input type="hidden" name="IsEdit" value="@Model.IsEdit.ToString().ToLower()" />

                    @if (Model.IsEdit)
                    {
                        <input type="hidden" asp-for="Entity.Plan.RecId" />
                    }

                    <h6 class="text-muted mb-3">Plan Bilgileri</h6>
                    <div class="row g-3 mb-4">

                        <input type="hidden" asp-for="Entity.Plan.CurrentAccountId" id="hdnCompanyRecId" />

                        <div class="col-md-3">
                            <label class="form-label">Cari Kodu</label>
                            <input type="text" id="txtCompanyCode" asp-for="Entity.Plan.CurrentAccountCode"
                                   class="form-control" readonly placeholder="Cari seçilince otomatik dolar" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label">Cari Adı (Firma)</label>
                            <select id="ddlCompany" class="form-select" style="width:100%;" required>
                                <option value="">Cari Seçiniz</option>
                            </select>
                            <input type="hidden" asp-for="Entity.Plan.CurrentAccountName" id="hdnCompanyName" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Vardiya</label>
                            <select asp-for="Entity.Plan.ShiftId" required asp-items="ViewBag.Shifts" class="form-select">
                                <option value="">Vardiya Seçiniz</option>
                            </select>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Plan Tarihi</label>
                            <input type="date" required asp-for="Entity.Plan.PlanDate" class="form-control" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Teslim Tarihi</label>
                            <input type="date" required asp-for="Entity.Plan.ReceiptDate" class="form-control" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Durum</label>
                            <select asp-for="Entity.Plan.Status" class="form-select">
                                <option value="0">Beklemede</option>
                                <option value="1">Onaylandı</option>
                                <option value="2">Sevk Edildi</option>
                            </select>
                            <div class="form-text">Durum kodlarını kendi iş kuralınıza göre güncelleyin.</div>
                        </div>

                        <div class="col-md-3">
                            <label class="form-label">Kayıt Eden</label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <ion-icon name="person-outline"></ion-icon>
                                </span>
                                <input type="text" class="form-control" value="@ViewBag.AppUserName" disabled />
                            </div>
                        </div>

                        <input type="hidden" asp-for="Entity.Plan.DepartmentId" />
                        <input type="hidden" asp-for="Entity.Plan.AppUserId" />
                        <input type="hidden" asp-for="Entity.Plan.InsertDate" />

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-muted mb-0">Detay Satırları</h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="addDetailRowBtn">
                            <ion-icon name="add-outline" class="me-1"></ion-icon>
                            Satır Ekle
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm align-middle" id="detailRowsTable">
                            <thead>
                                <tr>
                                    <th style="min-width:120px">Sipariş No</th>
                                    <th style="min-width:130px">Kağıt Cinsi</th>
                                    <th style="min-width:100px">Gramaj</th>
                                    <th style="min-width:100px">En</th>
                                    <th style="min-width:100px">Tonaj</th>
                                    <th style="min-width:130px">İrsaliye No</th>
                                    <th class="text-center">Checklist</th>
                                    <th class="text-center">Sevk Edildi</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody id="detailRowsBody">
                                @for (int i = 0; i < Model.Entity.Details.Count; i++)
                                {
                                    <tr class="detail-row">
                                        <td>
                                            <input type="hidden" asp-for="Entity.Details[i].RecId" />
                                            <input type="text" asp-for="Entity.Details[i].OrderNo" class="form-control form-control-sm" />
                                        </td>
                                        <td><input type="text" asp-for="Entity.Details[i].PaperType" class="form-control form-control-sm" /></td>
                                        <td><input type="number" step="0.01" asp-for="Entity.Details[i].Grammage" class="form-control form-control-sm" /></td>
                                        <td><input type="number" step="0.01" asp-for="Entity.Details[i].Width" class="form-control form-control-sm" /></td>
                                        <td><input type="number" step="0.01" asp-for="Entity.Details[i].Tonnage" class="form-control form-control-sm" /></td>
                                        <td><input type="text" asp-for="Entity.Details[i].DeliveryNoteNo" class="form-control form-control-sm" /></td>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   asp-for="Entity.Details[i].Checklist"
                                                   class="form-check-input" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox"
                                                   asp-for="Entity.Details[i].Shipped"
                                                   class="form-check-input" />
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-danger remove-detail-row" data-recid="@Model.Entity.Details[i].RecId">
                                                <ion-icon name="trash-outline"></ion-icon>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="deletedDetailIdsContainer"></div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-success px-4">
                        <ion-icon name="save-outline" class="me-1"></ion-icon>
                        @(Model.IsEdit ? "Güncelle" : "Kaydet")
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

