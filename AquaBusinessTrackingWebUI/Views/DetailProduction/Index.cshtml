@using System.Globalization
@using AquaBusinessTrackingWebUI.Controllers
@using DTOLayer.Dtos.SentezIntegrationsDtos.SentezIntegrationProductionDtos
@model AquaBusinessTrackingWebUI.Models.DetailProductionViewModel

@{
    ViewData["Title"] = "Üretim Plan Detayı";
    Layout = "~/Views/_UserLayout/Index.cshtml";
}

@functions {
    // Null olabilen tarih / sayı değerlerini tek yerden biçimlendirir ("-" döner)
    private static string Fmt(IFormattable? value, string format) => value?.ToString(format, null) ?? "-";

    // Tarih filtresi için satırlara yazılan ISO tarih (yyyy-MM-dd)
    private static string Iso(DateTime? d) => d?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture) ?? "";

    private const string DtFmt = "dd.MM.yyyy HH:mm";
}

<style>
    .pp-wrap {
        --pp-accent: var(--bs-primary, #0d6efd);
        --pp-teal: #17a589;
        --pp-warn: #f5a623;
        --pp-card-bg: #ffffff;
        --pp-soft-bg: #f6f7fb;
        --pp-hover-bg: #f0f3fa;
        --pp-border: rgba(0,0,0,.08);
        --pp-text: inherit;
        --pp-muted: #6c757d;
        --pp-radius: 10px;
        --pp-shadow: 0 .1rem .7rem rgba(0,0,0,.08);
        /* Template'teki bg-gradient-* sınıflarına benzeyen renkler.
               Birebir eşleşme için style.css'teki gradient'leri buraya yapıştır. */
        --pp-grad-tampon: linear-gradient(45deg, #0a58ca, #3d8bfd);
        --pp-grad-bobin: linear-gradient(45deg, #0f8b6d, #2ed19b);
        color: var(--pp-text);
        font-size: .9rem;
        padding: 0; /* .page-content zaten padding veriyor */
    }

    html.dark-theme .pp-wrap,
    [data-bs-theme="dark"] .pp-wrap {
        --pp-card-bg: #1c1f26;
        --pp-soft-bg: rgba(255,255,255,.04);
        --pp-hover-bg: rgba(255,255,255,.07);
        --pp-border: rgba(255,255,255,.1);
        --pp-muted: #9aa3b0;
        --pp-shadow: none;
    }

    /* ---------- Sayfa başlığı (breadcrumb ile uyumlu, sade) ---------- */
    .pp-header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 1.5rem;
    }

        .pp-header .pp-eyebrow {
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: var(--pp-muted);
            font-weight: 500;
            margin-bottom: 2px;
        }

        .pp-header h1 {
            font-size: 1.25rem;
            font-weight: 500;
            margin: 0;
            color: inherit;
        }

        .pp-header .pp-sub {
            color: var(--pp-muted);
            font-size: .8rem;
            margin-top: 2px;
        }

        .pp-header .pp-actions {
            display: flex;
            gap: 8px;
            align-items: center;
            flex-wrap: wrap;
        }

    .pp-actions input[type="date"],
    .pp-actions input[type="search"] {
        border: 1px solid var(--pp-border);
        border-radius: 6px;
        padding: 7px 12px;
        font-size: .82rem;
        background: var(--pp-card-bg);
        color: inherit;
        outline: none;
    }

    .pp-actions input:focus {
        border-color: var(--pp-accent);
        box-shadow: 0 0 0 .2rem rgba(13,110,253,.15);
    }

    /* ---------- Butonlar (template btn görünümü) ---------- */
    .pp-btn {
        border: 1px solid transparent;
        border-radius: 6px;
        padding: 7px 16px;
        font-size: .82rem;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all .15s;
    }

    .pp-btn-primary {
        background: var(--pp-accent);
        color: #fff;
    }

        .pp-btn-primary:hover {
            filter: brightness(.92);
            color: #fff;
        }

    .pp-btn-ghost {
        background: transparent;
        color: var(--pp-accent);
        border-color: var(--pp-accent);
    }

        .pp-btn-ghost:hover {
            background: var(--pp-accent);
            color: #fff;
        }

    .pp-section-title {
        font-size: .95rem;
        font-weight: 500;
        color: inherit;
        margin: 0 0 12px 0;
    }

    /* ---------- KPI kartları (index'teki üst widget'lar gibi) ---------- */
    .pp-stats, .pp-kpi-row {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    @@media (max-width:1400px) {
        .pp-stats, .pp-kpi-row {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width:1100px) {
        .pp-stats, .pp-kpi-row {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width:576px) {
        .pp-stats, .pp-kpi-row {
            grid-template-columns: 1fr;
        }
    }

    .pp-stat {
        background: var(--pp-card-bg);
        border: 0;
        border-radius: var(--pp-radius);
        padding: 1rem 1.25rem;
        box-shadow: var(--pp-shadow);
    }

        /* Renk varyasyonları artık üst çizgi yerine değer rengiyle */
        .pp-stat.alt .val {
            color: var(--pp-teal);
        }

        .pp-stat.warn .val {
            color: var(--pp-warn);
        }

        .pp-stat .lbl {
            font-size: 1rem;
            color: inherit;
            font-weight: 400;
            margin: 0;
        }

        .pp-stat .val {
            font-size: 1.5rem;
            font-weight: 500;
            margin-top: .75rem;
            color: inherit;
        }

            .pp-stat .val small {
                font-size: .72rem;
                font-weight: 400;
                color: var(--pp-muted);
                margin-left: 4px;
            }

        .pp-stat .trend {
            font-size: .78rem;
            color: var(--pp-muted);
            margin-top: 4px;
        }

    /* ---------- Ana kart (card radius-10) ---------- */
    .pp-card {
        background: var(--pp-card-bg);
        border: 0;
        border-radius: var(--pp-radius);
        overflow: hidden;
        margin-bottom: 1.5rem;
        box-shadow: var(--pp-shadow);
    }

    /* ---------- Sekmeler (Bootstrap nav-tabs görünümü) ---------- */
    .pp-tabs {
        display: flex;
        border-bottom: 1px solid var(--pp-border);
        padding: 0 .75rem;
        overflow-x: auto;
    }

    .pp-tab-btn {
        border: none;
        background: transparent;
        padding: 14px 16px;
        font-size: .88rem;
        font-weight: 500;
        color: var(--pp-muted);
        cursor: pointer;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

        .pp-tab-btn:hover {
            color: var(--pp-accent);
        }

        .pp-tab-btn .badge-count {
            background: var(--pp-soft-bg);
            color: inherit;
            border-radius: 10px;
            padding: 1px 8px;
            font-size: .7rem;
            font-weight: 500;
        }

        .pp-tab-btn.active {
            color: var(--pp-accent);
            border-bottom-color: var(--pp-accent);
        }

            .pp-tab-btn.active .badge-count {
                background: var(--pp-accent);
                color: #fff;
            }

    .pp-tab-panel {
        display: none;
        padding: 1.25rem;
    }

        .pp-tab-panel.active {
            display: block;
        }

    .pp-panel-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-bottom: 14px;
    }

        .pp-panel-toolbar h6 {
            margin: 0;
            font-weight: 500;
            color: inherit;
            font-size: 1rem;
        }

    /* ---------- Tablo (table table-light / align-middle) ---------- */
    table.pp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
        color: inherit;
    }

        table.pp-table thead th {
            background: var(--pp-soft-bg);
            color: inherit;
            font-weight: 500;
            text-align: left;
            padding: 10px 12px;
            border-bottom: 1px solid var(--pp-border);
            white-space: nowrap;
            position: sticky;
            top: 0;
            font-size: .8rem;
            z-index: 1;
        }

        table.pp-table tbody td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--pp-border);
            white-space: nowrap;
            vertical-align: middle;
        }

        table.pp-table tbody tr:hover {
            background: var(--pp-hover-bg);
        }

    .pp-table-scroll {
        max-height: 520px;
        overflow: auto;
        border: 1px solid var(--pp-border);
        border-radius: 8px;
    }

    /* ---------- Chip'ler (bg-light-success text-success tarzı) ---------- */
    .pp-chip {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 4px;
        font-size: .72rem;
        font-weight: 500;
    }

    .pp-chip-on {
        background: rgba(23,160,86,.12);
        color: #17a056;
    }

    .pp-chip-off {
        background: rgba(220,53,69,.12);
        color: #dc3545;
    }

    .pp-chip-neutral {
        background: var(--pp-soft-bg);
        color: inherit;
    }

    .pp-chip-tampon {
        background: rgba(13,110,253,.12);
        color: var(--pp-accent);
    }

    .pp-chip-bobin {
        background: rgba(23,165,137,.14);
        color: var(--pp-teal);
    }

    /* ---------- PLC grupları ---------- */
    .pp-plc-group {
        margin-bottom: 20px;
    }

        .pp-plc-group h6 {
            font-size: .85rem;
            font-weight: 500;
            color: inherit;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pp-plc-group h6::after {
                content: "";
                flex: 1;
                height: 1px;
                background: var(--pp-border);
            }

    .pp-plc-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 1rem;
    }

    .pp-plc-card {
        background: var(--pp-soft-bg);
        border: 0;
        border-radius: 8px;
        padding: 12px 14px;
    }

        .pp-plc-card .name {
            font-size: .78rem;
            color: var(--pp-muted);
            margin-bottom: 6px;
        }

        .pp-plc-card .value {
            font-size: 1.25rem;
            font-weight: 500;
            color: inherit;
        }

            .pp-plc-card .value small {
                font-size: .72rem;
                color: var(--pp-muted);
                font-weight: 400;
                margin-left: 3px;
            }

        .pp-plc-card .time {
            font-size: .72rem;
            color: var(--pp-muted);
            margin-top: 6px;
        }

    .pp-empty {
        text-align: center;
        padding: 40px 10px;
        color: var(--pp-muted);
        font-size: .9rem;
    }

    /* ---------- Tip kartları (gradient, index'teki bg-gradient-* gibi) ---------- */
    .pp-type-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    @@media (max-width:900px) {
        .pp-type-row {
            grid-template-columns: 1fr;
        }
    }

    .pp-type-card {
        border-radius: var(--pp-radius);
        padding: 1.25rem 1.5rem;
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: var(--pp-shadow);
    }

        .pp-type-card.tampon {
            background: var(--pp-grad-tampon);
        }

        .pp-type-card.bobin {
            background: var(--pp-grad-bobin);
        }

        .pp-type-card .tc-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .pp-type-card .tc-title {
            font-size: 1rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .pp-type-card .tc-code {
            font-size: .68rem;
            background: rgba(255,255,255,.2);
            padding: 3px 10px;
            border-radius: 4px;
            font-weight: 500;
        }

        .pp-type-card .tc-metrics {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

    @@media (max-width:560px) {
        .pp-type-card .tc-metrics {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    .pp-type-card .tc-metric .m-val {
        font-size: 1.3rem;
        font-weight: 500;
        line-height: 1.1;
    }

    .pp-type-card .tc-metric .m-lbl {
        font-size: .7rem;
        opacity: .85;
        margin-top: 3px;
    }

    /* ---------- Filtre butonları ---------- */
    .pp-type-filter {
        display: flex;
        gap: 8px;
        margin-bottom: 12px;
        flex-wrap: wrap;
    }

        .pp-type-filter button {
            border: 1px solid var(--pp-border);
            background: transparent;
            color: inherit;
            font-size: .8rem;
            font-weight: 500;
            padding: 6px 14px;
            border-radius: 6px;
            cursor: pointer;
        }

            .pp-type-filter button:hover {
                border-color: var(--pp-accent);
                color: var(--pp-accent);
            }

            .pp-type-filter button.active {
                background: var(--pp-accent);
                color: #fff;
                border-color: var(--pp-accent);
            }

    /* ---------- Ağaç yapısı ---------- */
    .pp-tree-node {
        border: 1px solid var(--pp-border);
        border-radius: 8px;
        margin-bottom: 10px;
        overflow: hidden;
    }

    .pp-tree-parent {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        background: var(--pp-soft-bg);
        cursor: pointer;
        flex-wrap: wrap;
    }

        .pp-tree-parent:hover {
            background: var(--pp-hover-bg);
        }

    .pp-tree-caret {
        transition: transform .15s;
        color: var(--pp-accent);
        flex-shrink: 0;
    }

    .pp-tree-node.open .pp-tree-caret {
        transform: rotate(90deg);
    }

    .pp-tree-serial {
        font-weight: 500;
        color: inherit;
        font-size: .88rem;
    }

    .pp-tree-meta {
        font-size: .78rem;
        color: var(--pp-muted);
    }

    .pp-tree-children {
        display: none;
        padding: 0 14px 14px 40px;
        border-top: 1px solid var(--pp-border);
    }

    .pp-tree-node.open .pp-tree-children {
        display: block;
        padding-top: 12px;
    }

    .pp-progress-bar {
        height: 5px;
        background: var(--pp-soft-bg);
        border-radius: 4px;
        overflow: hidden;
        margin-top: 8px;
    }

        .pp-progress-bar > span {
            display: block;
            height: 100%;
            background: var(--pp-teal);
        }

    /* ---------- Yardımcı sınıflar (inline style yerine) ---------- */
    .pp-local-input {
        border: 1px solid var(--pp-border);
        border-radius: 6px;
        padding: 6px 10px;
        font-size: .8rem;
        background: var(--pp-card-bg);
        color: inherit;
        outline: none;
    }

        .pp-local-input:focus {
            border-color: var(--pp-accent);
        }

    .pp-global-search {
        min-width: 240px;
    }

    .pp-push-right {
        margin-left: auto;
    }

    .pp-mt {
        margin-top: 20px;
    }

    .pp-tree-parent:focus-visible,
    .pp-tab-btn:focus-visible {
        outline: 2px solid var(--pp-accent);
        outline-offset: -2px;
    }
</style>

<div class="pp-wrap">

    <!-- ===================== BAŞLIK ===================== -->
    <div class="pp-header">
        <div>
            <div class="pp-eyebrow">Üretim Yönetim Sistemi</div>
            <h1>Üretim Plan Detayı</h1>
            <div class="pp-sub">PLC anlık verileri, kombinasyon, üretim ve verimlilik göstergeleri tek ekranda</div>
        </div>
        <div class="pp-actions">
            <input type="date" id="ppDateFilter" />
            <input type="search" id="ppGlobalSearch" class="pp-global-search" placeholder="Kombinasyon / stok / seri no ara..." />
            <button type="button" class="pp-btn pp-btn-ghost" onclick="location.reload()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 4 23 10 17 10" /><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" /></svg>
                Yenile
            </button>
            <button type="button" class="pp-btn pp-btn-primary" onclick="window.print()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                Yazdır
            </button>
        </div>
    </div>

    <!-- ===================== GENEL ÖZET ===================== -->
    <div class="pp-section-title">Genel Özet</div>
    <div class="pp-stats">
        <div class="pp-stat">
            <div class="lbl">PLC Okuma Sayısı</div>
            <div class="val">@Model.Summary.TotalPlc</div>
        </div>
        <div class="pp-stat alt">
            <div class="lbl">Aktif Kombinasyon</div>
            <div class="val">@Model.Summary.ActiveSets</div>
        </div>
        <div class="pp-stat">
            <div class="lbl">Kombinasyon Kaydı</div>
            <div class="val">@Model.Summary.TotalCombine</div>
        </div>
        <div class="pp-stat alt">
            <div class="lbl">Kombinasyon Miktarı</div>
            <div class="val">@Model.Summary.TotalCombineQty.ToString("N0")<small>kg</small></div>
        </div>
        <div class="pp-stat">
            <div class="lbl">Üretim Kaydı / Miktar</div>
            <div class="val">@Model.Summary.TotalProd<small>/ @Model.Summary.TotalProdQty.ToString("N0") kg</small></div>
        </div>
    </div>

    <!-- ===================== VERİMLİLİK ===================== -->
    <div class="pp-section-title">Verimlilik ve Performans Göstergeleri</div>
    <div class="pp-kpi-row">
        <div class="pp-stat alt">
            <div class="lbl">Kesim Verimi</div>
            <div class="val">@Model.Summary.CuttingYieldPercent.ToString("N1")<small>%</small></div>
            <div class="pp-progress-bar"><span style="width:@(Math.Min(100, Model.Summary.CuttingYieldPercent).ToString("N0", CultureInfo.InvariantCulture))%;"></span></div>
            <div class="trend">Kesilen tampondan elde edilen bobin oranı</div>
        </div>
        <div class="pp-stat warn">
            <div class="lbl">Fire Oranı</div>
            <div class="val">@Model.Summary.FireLossPercent.ToString("N1")<small>%</small></div>
            <div class="trend">@Model.Summary.FireLossQty.ToString("N0") kg fire</div>
        </div>
        <div class="pp-stat">
            <div class="lbl">Bekleyen Tampon Oranı</div>
            <div class="val">@Model.Summary.WaitingRatioPercent.ToString("N1")<small>%</small></div>
            <div class="trend">@Model.WaitingTampons.Count tampon henüz kesilmedi</div>
        </div>
        <div class="pp-stat">
            <div class="lbl">Plan / Gerçekleşme</div>
            <div class="val">@Model.Summary.PlanActualPercent.ToString("N1")<small>%</small></div>
            <div class="trend">Üretim miktarı / kombinasyon miktarı</div>
        </div>
        <div class="pp-stat alt">
            <div class="lbl">Ort. Çevrim Süresi</div>
            <div class="val">@Model.Summary.AvgCycleMinutes.ToString("N0")<small>dk</small></div>
            <div class="trend">Ort. hız: @Model.Summary.AvgResourceSpeed.ToString("N1")</div>
        </div>
    </div>

    <!-- ===================== TİP KARTLARI ===================== -->
    <div class="pp-type-row">
        <div class="pp-type-card tampon">
            <div class="tc-head">
                <div class="tc-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v3" /></svg>
                    Tampon Üretimi
                </div>
            </div>
            <div class="tc-metrics">
                <div class="tc-metric">
                    <div class="m-val">@Model.Summary.TamponCount</div>
                    <div class="m-lbl">Kayıt</div>
                </div>
                <div class="tc-metric">
                    <div class="m-val">@Model.Summary.TamponQty.ToString("N0")</div>
                    <div class="m-lbl">Toplam Kg</div>
                </div>
                <div class="tc-metric">
                    <div class="m-val">@Model.Summary.TamponSets</div>
                    <div class="m-lbl">Kombinasyon</div>
                </div>
                <div class="tc-metric">
                    <div class="m-val">@Model.Summary.StrapCompletionPercent.ToString("N0")%</div>
                    <div class="m-lbl">Strap Tamamlama</div>
                </div>
            </div>
        </div>
        <div class="pp-type-card bobin">
            <div class="tc-head">
                <div class="tc-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="3" /></svg>
                    Bobin Üretimi
                </div>
            </div>
            <div class="tc-metrics">
                <div class="tc-metric">
                    <div class="m-val">@Model.Summary.BobinCount</div>
                    <div class="m-lbl">Kayıt</div>
                </div>
                <div class="tc-metric">
                    <div class="m-val">@Model.Summary.BobinQty.ToString("N0")</div>
                    <div class="m-lbl">Toplam Kg</div>
                </div>
                <div class="tc-metric">
                    <div class="m-val">@Model.Summary.BobinSets</div>
                    <div class="m-lbl">Kombinasyon</div>
                </div>
                <div class="tc-metric">
                    <div class="m-val">@Model.Summary.WrapCompletionPercent.ToString("N0")%</div>
                    <div class="m-lbl">Sarım Tamamlama</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===================== SEKMELER ===================== -->
    <div class="pp-card">
        <div class="pp-tabs">
            <button type="button" class="pp-tab-btn active" data-tab="plc" onclick="ppSwitchTab('plc')">
                PLC Anlık Veriler <span class="badge-count">@Model.Summary.TotalPlc</span>
            </button>
            <button type="button" class="pp-tab-btn" data-tab="combine" onclick="ppSwitchTab('combine')">
                Kombinasyon Detayları <span class="badge-count">@Model.Summary.TotalCombine</span>
            </button>
            <button type="button" class="pp-tab-btn" data-tab="prod" onclick="ppSwitchTab('prod')">
                Üretim Detayları <span class="badge-count">@Model.Summary.TotalProd</span>
            </button>
            <button type="button" class="pp-tab-btn" data-tab="tree" onclick="ppSwitchTab('tree')">
                Kesim Ağacı (Tampon → Bobin) <span class="badge-count">@Model.TamponCutTree.Count</span>
            </button>
            <button type="button" class="pp-tab-btn" data-tab="waiting" onclick="ppSwitchTab('waiting')">
                Bekleyen Tamponlar <span class="badge-count">@Model.WaitingTampons.Count</span>
            </button>
        </div>

        <!-- TAB 1: PLC ANLIK VERİLER -->
        <div class="pp-tab-panel active" id="pp-panel-plc">
            @if (Model.PlcReading == null || !Model.PlcReading.Any())
            {
                <div class="pp-empty">Gösterilecek PLC verisi bulunamadı.</div>
            }
            else
            {
                foreach (var grp in Model.PlcReading.GroupBy(x => x.Group ?? "Diğer"))
                {
                    <div class="pp-plc-group">
                        <h6>@grp.Key</h6>
                        <div class="pp-plc-grid">
                            @foreach (var r in grp.OrderBy(x => x.DisplayName))
                            {
                                <div class="pp-plc-card">
                                    <div class="name">@r.DisplayName</div>
                                    <div class="value">@r.Value.ToString("N2") <small>@r.Unit</small></div>
                                    <div class="time">@r.ReadingTime.ToString("dd.MM.yyyy HH:mm:ss")</div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- TAB 2: KOMBİNASYON DETAYLARI -->
        <div class="pp-tab-panel" id="pp-panel-combine">
            <div class="pp-panel-toolbar">
                <h6>Kombinasyon Detayları</h6>
                <input type="search" class="pp-local-search pp-local-input" data-target="tbl-combine" placeholder="Bu tabloda ara..." />
            </div>
            @if (Model.SentezIntegrationsGetCombineDetails == null || !Model.SentezIntegrationsGetCombineDetails.Any())
            {
                <div class="pp-empty">Kombinasyon kaydı bulunamadı.</div>
            }
            else
            {
                <div class="pp-table-scroll">
                    <table class="pp-table" id="tbl-combine">
                        <thead>
                            <tr>
                                <th>Fiş Tarihi</th>
                                <th>Kombine No</th>
                                <th>Planlanan Set / Enleri</th>
                                <th>Stok Adı</th>
                                <th>Miktar (kg)</th>
                                <th>Set Tekrar Sayısı</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.SentezIntegrationsGetCombineDetails.OrderByDescending(x => x.ReceiptDate))
                            {
                                <tr data-date="@Iso(c.ReceiptDate)">
                                    <td>@Fmt(c.ReceiptDate, DtFmt)</td>
                                    <td><span class="pp-chip pp-chip-neutral">@c.CombinationNo</span></td>
                                    <td>@c.AssignedResources</td>
                                    <td>@c.InventoryName</td>
                                    <td>@c.Quantity.ToString("N2")</td>
                                    <td>@c.FinishDailyQuantity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- TAB 3: ÜRETİM DETAYLARI -->
        <div class="pp-tab-panel" id="pp-panel-prod">
            <div class="pp-panel-toolbar">
                <h6>Üretim Detayları</h6>
                <input type="search" class="pp-local-search pp-local-input" data-target="tbl-prod" placeholder="Bu tabloda ara..." />
            </div>
            <div class="pp-type-filter">
                <button type="button" class="active" onclick="ppSetTypeFilter('all', this)">Tümü (@Model.Summary.TotalProd)</button>
                <button type="button" onclick="ppSetTypeFilter('tampon', this)">Tampon (@Model.Summary.TamponCount)</button>
                <button type="button" onclick="ppSetTypeFilter('bobin', this)">Bobin (@Model.Summary.BobinCount)</button>
            </div>
            @if (Model.SentezIntegrationsGetProductionDetails == null || !Model.SentezIntegrationsGetProductionDetails.Any())
            {
                <div class="pp-empty">Üretim kaydı bulunamadı.</div>
            }
            else
            {
                // Bağlı tampon aramasını satır başına tarama yerine sözlükle yap (O(n²) -> O(n))
                var tamponRows = Model.SentezIntegrationsGetProductionDetails
                .Where(ProductionDetailBuilder.IsTampon)
                .ToList();

                var tamponByRecId = tamponRows
                .GroupBy(x => Convert.ToInt64(x.RecId))
                .ToDictionary(g => g.Key, g => g.First());

                var tamponBySerial = tamponRows
                .Where(x => !string.IsNullOrWhiteSpace(x.SerialCode))
                .GroupBy(x => x.SerialCode!.Trim(), StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

                <div class="pp-table-scroll">
                    <table class="pp-table" id="tbl-prod">
                        <thead>
                            <tr>
                                <th>Tip</th>
                                <th>Fiş Tarihi</th>
                                <th>Başlangıç</th>
                                <th>Bitiş</th>
                                <th>Seri No</th>
                                <th>Miktar</th>
                                <th>Stok Kodu</th>
                                <th>Stok Adı</th>
                                <th>En (cm)</th>
                                <th>Kombine No</th>
                                <th>Bağlı Tampon</th>
                                <th>Set No / Poz.</th>
                                <th>Açıklama</th>
                                <th>Personel</th>
                                <th>Hız</th>
                                <th>İş Emri No</th>
                                <th>Teslim Tarihi</th>
                                <th>Strap</th>
                                <th>Sarım</th>
                                <th>Stoper</th>
                                <th>Etiket</th>
                                <th>Depo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.SentezIntegrationsGetProductionDetails.OrderByDescending(x => x.ReceiptDate))
                            {
                                var serial = p.SerialCode?.Trim();
                                var isTampon = ProductionDetailBuilder.IsTampon(p);

                                SentezIntegrationsGetProductionDetailsDto? parentTampon = null;
                                if (!isTampon)
                                {
                                    // 1) ParentSerialId, 2) seri kodunun ilk 12 hanesi
                                    if (!(p.ParentSerialId.HasValue
                                    && tamponByRecId.TryGetValue(Convert.ToInt64(p.ParentSerialId.Value), out parentTampon))
                                    && serial != null && serial.Length >= 12)
                                    {
                                        tamponBySerial.TryGetValue(serial.Substring(0, 12), out parentTampon);
                                    }
                                }

                                <tr data-type="@(isTampon ? "tampon" : "bobin")" data-date="@Iso(p.ReceiptDate)">
                                    <td><span class="pp-chip @(isTampon ? "pp-chip-tampon" : "pp-chip-bobin")">@(isTampon ? "Tampon" : "Bobin")</span></td>
                                    <td>@Fmt(p.ReceiptDate, DtFmt)</td>
                                    <td>@Fmt(p.StartTime, DtFmt)</td>
                                    <td>@Fmt(p.EndTime, DtFmt)</td>
                                    <td>@(serial ?? "-")</td>
                                    <td>@Fmt(p.Quantity, "N2")</td>
                                    <td>@(p.InventoryCode ?? "-")</td>
                                    <td>@(p.InventoryName ?? "-")</td>
                                    <td>@Fmt(p.WidthCM, "N1")</td>
                                    <td>@(p.CombinationNo ?? "-")</td>
                                    <td>@(parentTampon?.SerialCode ?? "-")</td>
                                    <td>@(p.SetNumber?.ToString() ?? "-") / @(p.SetPosition?.ToString() ?? "-")</td>
                                    <td>@(p.Explanation ?? "-")</td>
                                    <td>@(p.EmployeeName ?? "-")</td>
                                    <td>@Fmt(p.ResourceSpeed, "N1")</td>
                                    <td>@(p.WorkOrderNo ?? "-")</td>
                                    <td>@Fmt(p.DeliveryDate, "dd.MM.yyyy")</td>
                                    <td><span class="pp-chip @(p.IsStrapping == 1 ? "pp-chip-on" : "pp-chip-off")">@(p.IsStrapping == 1 ? "Evet" : "Hayır")</span></td>
                                    <td><span class="pp-chip @(p.IsWrapping == 1 ? "pp-chip-on" : "pp-chip-off")">@(p.IsWrapping == 1 ? "Evet" : "Hayır")</span></td>
                                    <td>@Fmt(p.StopperAt, DtFmt)</td>
                                    <td>@Fmt(p.LabelAt, DtFmt)</td>
                                    <td>@Fmt(p.WarehouseAt, DtFmt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- TAB 4: KESİM AĞACI (TAMPON -> BOBİN) -->
        <div class="pp-tab-panel" id="pp-panel-tree">
            <div class="pp-panel-toolbar">
                <h6>Tampon → Bobin Kesim Ağacı</h6>
                <span class="pp-chip pp-chip-neutral">Kesim Verimi: @Model.Summary.CuttingYieldPercent.ToString("N1")%</span>
            </div>
            @if (!Model.TamponCutTree.Any())
            {
                <div class="pp-empty">Kesilmiş tampon kaydı bulunamadı.</div>
            }
            else
            {
                foreach (var node in Model.TamponCutTree)
                {
                    var t = node.Tampon;
                    <div class="pp-tree-node" data-date="@Iso(t.ReceiptDate)">
                        <div class="pp-tree-parent" role="button" tabindex="0" onclick="ppToggleNode(this)" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();ppToggleNode(this);}">
                            <svg class="pp-tree-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="9 6 15 12 9 18" /></svg>
                            <span class="pp-chip pp-chip-tampon">Tampon</span>
                            <span class="pp-tree-serial">@(t.SerialCode ?? "-")</span>
                            <span class="pp-tree-meta">@(t.InventoryName ?? "-")</span>
                            <span class="pp-tree-meta">@Fmt(t.Quantity, "N2") kg</span>
                            <span class="pp-tree-meta">En: @Fmt(t.WidthCM, "N1") cm</span>
                            <span class="pp-tree-meta">@Fmt(t.ReceiptDate, DtFmt)</span>
                            <span class="pp-chip pp-chip-neutral pp-push-right">@node.BobinCount bobin · @node.BobinQtySum.ToString("N0") kg · Verim %@node.NodeYieldPercent.ToString("N0")</span>
                        </div>
                        <div class="pp-tree-children">
                            <table class="pp-table">
                                <thead>
                                    <tr>
                                        <th>Fiş Tarihi</th>
                                        <th>Seri No</th>
                                        <th>Stok Kodu</th>
                                        <th>Stok Adı</th>
                                        <th>Miktar</th>
                                        <th>En (cm)</th>
                                        <th>Kombine No</th>
                                        <th>Sarım</th>
                                        <th>Depo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var b in node.Bobinler)
                                    {
                                        <tr data-date="@Iso(b.ReceiptDate)">
                                            <td>@Fmt(b.ReceiptDate, DtFmt)</td>
                                            <td>@(b.SerialCode ?? "-")</td>
                                            <td>@(b.InventoryCode ?? "-")</td>
                                            <td>@(b.InventoryName ?? "-")</td>
                                            <td>@Fmt(b.Quantity, "N2")</td>
                                            <td>@Fmt(b.WidthCM, "N1")</td>
                                            <td>@(b.CombinationNo ?? "-")</td>
                                            <td><span class="pp-chip @(b.IsWrapping == 1 ? "pp-chip-on" : "pp-chip-off")">@(b.IsWrapping == 1 ? "Evet" : "Hayır")</span></td>
                                            <td>@Fmt(b.WarehouseAt, DtFmt)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }

            @if (Model.UnmatchedBobinList != null && Model.UnmatchedBobinList.Any())
            {
                <div class="pp-plc-group pp-mt">
                    <h6>Eşleşmeyen Bobinler (Tampon Bulunamadı) — @Model.UnmatchedBobinList.Count adet</h6>
                    <div class="pp-table-scroll">
                        <table class="pp-table">
                            <thead>
                                <tr>
                                    <th>Fiş Tarihi</th>
                                    <th>Seri No</th>
                                    <th>Stok Kodu</th>
                                    <th>Stok Adı</th>
                                    <th>Miktar</th>
                                    <th>En (cm)</th>
                                    <th>Kombine No</th>
                                    <th>ParentId</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.UnmatchedBobinList)
                                {
                                    <tr data-date="@Iso(b.ReceiptDate)">
                                        <td>@Fmt(b.ReceiptDate, DtFmt)</td>
                                        <td>@(b.SerialCode ?? "-")</td>
                                        <td>@(b.InventoryCode ?? "-")</td>
                                        <td>@(b.InventoryName ?? "-")</td>
                                        <td>@Fmt(b.Quantity, "N2")</td>
                                        <td>@Fmt(b.WidthCM, "N1")</td>
                                        <td>@(b.CombinationNo ?? "-")</td>
                                        <td>@(b.ParentSerialId?.ToString() ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- TAB 5: BEKLEYEN TAMPONLAR -->
        <div class="pp-tab-panel" id="pp-panel-waiting">
            <div class="pp-panel-toolbar">
                <h6>Bekleyen Tamponlar (Henüz Kesilmemiş)</h6>
                <span class="pp-chip pp-chip-neutral">Toplam: @Model.WaitingTampons.Sum(x => x.Quantity ?? 0).ToString("N0") kg</span>
            </div>
            @if (!Model.WaitingTampons.Any())
            {
                <div class="pp-empty">Bekleyen tampon bulunamadı, tüm tamponlar kesilmiş.</div>
            }
            else
            {
                <div class="pp-table-scroll">
                    <table class="pp-table">
                        <thead>
                            <tr>
                                <th>Fiş Tarihi</th>
                                <th>Seri No</th>
                                <th>Stok Kodu</th>
                                <th>Stok Adı</th>
                                <th>Miktar</th>
                                <th>En (cm)</th>
                                <th>Kombine No</th>
                                <th>İş Emri No</th>
                                <th>Depo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in Model.WaitingTampons)
                            {
                                <tr data-date="@Iso(t.ReceiptDate)">
                                    <td>@Fmt(t.ReceiptDate, DtFmt)</td>
                                    <td>@(t.SerialCode ?? "-")</td>
                                    <td>@(t.InventoryCode ?? "-")</td>
                                    <td>@(t.InventoryName ?? "-")</td>
                                    <td>@Fmt(t.Quantity, "N2")</td>
                                    <td>@Fmt(t.WidthCM, "N1")</td>
                                    <td>@(t.CombinationNo ?? "-")</td>
                                    <td>@(t.WorkOrderNo ?? "-")</td>
                                    <td>@Fmt(t.WarehouseAt, DtFmt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Tüm filtreler (genel arama, tarih, tablo içi arama, tip) tek yerde birleşir
    var ppState = { global: '', date: '', type: 'all', local: {} };

    function ppSwitchTab(tab) {
        document.querySelectorAll('.pp-tab-btn').forEach(function (b) {
            b.classList.toggle('active', b.dataset.tab === tab);
        });
        document.querySelectorAll('.pp-tab-panel').forEach(function (p) {
            p.classList.toggle('active', p.id === 'pp-panel-' + tab);
        });
    }

    function ppToggleNode(headerEl) {
        headerEl.parentElement.classList.toggle('open');
    }

    function ppSetTypeFilter(type, btn) {
        ppState.type = type;
        document.querySelectorAll('.pp-type-filter button').forEach(function (b) {
            b.classList.toggle('active', b === btn);
        });
        ppApplyFilters();
    }

    function ppApplyFilters() {
        var g = ppState.global, d = ppState.date;

        // Normal tablolar (ağaç içindekiler hariç, onlar node bazında süzülür)
        document.querySelectorAll('table.pp-table').forEach(function (table) {
            if (table.closest('.pp-tree-node')) return;
            var local = ppState.local[table.id] || '';
            table.querySelectorAll('tbody tr').forEach(function (row) {
                var text = row.textContent.toLowerCase();
                var ok = (!g || text.includes(g))
                    && (!local || text.includes(local))
                    && (!d || row.dataset.date === d)
                    && (ppState.type === 'all' || !row.dataset.type || row.dataset.type === ppState.type);
                row.style.display = ok ? '' : 'none';
            });
        });

        // Kesim ağacı: tampon veya altındaki bobinlerden biri eşleşirse göster
        document.querySelectorAll('.pp-tree-node').forEach(function (node) {
            var textOk = !g || node.textContent.toLowerCase().includes(g);
            var dateOk = !d || node.dataset.date === d || node.querySelector('tbody tr[data-date="' + d + '"]') !== null;
            node.style.display = (textOk && dateOk) ? '' : 'none';
        });
    }

    document.querySelectorAll('.pp-local-search').forEach(function (input) {
        input.addEventListener('input', function () {
            ppState.local[this.dataset.target] = this.value.trim().toLowerCase();
            ppApplyFilters();
        });
    });

    document.getElementById('ppGlobalSearch').addEventListener('input', function () {
        ppState.global = this.value.trim().toLowerCase();
        ppApplyFilters();
    });

    document.getElementById('ppDateFilter').addEventListener('change', function () {
        ppState.date = this.value; // yyyy-MM-dd (satırlardaki data-date ile aynı format)
        ppApplyFilters();
    });
</script>
