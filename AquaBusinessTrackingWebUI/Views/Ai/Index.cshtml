@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/_UserLayout/Index.cshtml";
}

<div class="ai-search-page">

    <div class="ai-chat-messages" id="aiChatMessages">

        <div class="ai-empty-state" id="aiEmptyState">
            <ion-icon name="chatbubble-ellipses-outline"></ion-icon>
            <h3 class="ai-title">Aqua AI Beta</h3>
            <p class="ai-subtitle">Aradığınız bilgiyi yazın, sizin için ilgili verileri bulalım.</p>
            <span class="ai-subtitle">Beta sürümdür veriler yanlış olabilir.</span>
            <div class="ai-suggestions" id="aiSuggestions">
                <span class="ai-chip">Geçen ayki sevkiyatlar</span>
                <span class="ai-chip">Stok durumu özeti</span>
                <span class="ai-chip">Bu haftaki satışlar</span>
            </div>
        </div>

    </div>

    <div class="ai-input-wrapper">
        <div class="ai-input-inner">
            <ion-icon name="chatbubble-ellipses-outline" class="ai-input-icon"></ion-icon>
            <input type="text" id="aiQueryInput" class="ai-input"
                   placeholder="Örn: Geçen ayki sevkiyat raporunu göster" />
            <button class="ai-send-btn" id="aiAskBtn" type="button">
                <ion-icon name="send-outline"></ion-icon>
            </button>
        </div>
    </div>

</div>

<style>
    :root {
        --ai-primary: #10233f;
        --ai-primary-dark: #0a1830;
        --ai-accent: #2c4a72;
        --ai-border: rgba(16, 35, 63, 0.14);
        --ai-muted: #64748b;
        --ai-bg-soft: #f7f8fa;
    }

    /* ---- Kutu yok, tüm sayfa chat alanı ---- */
    .ai-search-page {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: var(--bs-body-bg, #fff);
    }

    .ai-chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 32px 24px 16px;
        display: flex;
        flex-direction: column;
        gap: 18px;
        scroll-behavior: smooth;
        max-width: 820px;
        width: 100%;
        margin: 0 auto;
        box-sizing: border-box;
    }

        .ai-chat-messages::-webkit-scrollbar {
            width: 8px;
        }

        .ai-chat-messages::-webkit-scrollbar-thumb {
            background: rgba(16, 35, 63, 0.15);
            border-radius: 10px;
        }

    .ai-empty-state {
        margin: auto;
        text-align: center;
        color: var(--ai-muted);
    }

        .ai-empty-state ion-icon {
            font-size: 40px;
            color: var(--ai-accent);
            margin-bottom: 12px;
        }

    .ai-title {
        font-weight: 600;
        letter-spacing: -0.01em;
        margin-bottom: 6px;
        color: var(--bs-heading-color, #101828);
    }

    .ai-subtitle {
        color: var(--ai-muted);
        font-size: 0.92rem;
        font-weight: 400;
        margin-bottom: 18px;
    }

    .ai-suggestions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px;
    }

    .ai-chip {
        font-size: 0.82rem;
        font-weight: 500;
        padding: 7px 14px;
        border-radius: 20px;
        background: var(--ai-bg-soft);
        color: var(--ai-primary);
        border: 1px solid var(--ai-border);
        cursor: pointer;
        white-space: nowrap;
        transition: background .15s ease, border-color .15s ease;
    }

        .ai-chip:hover {
            background: #edf1f5;
            border-color: rgba(16, 35, 63, 0.22);
        }

    /* ---- Mesaj baloncukları ---- */
    .ai-msg-row {
        display: flex;
        gap: 10px;
        animation: ai-fade-in .2s ease;
        max-width: 100%;
    }

        .ai-msg-row.user {
            justify-content: flex-end;
        }

    .ai-msg-bubble {
        max-width: 75%;
        padding: 12px 16px;
        border-radius: 12px;
        font-size: 0.95rem;
        line-height: 1.6;
        word-wrap: break-word;
    }

    .ai-msg-row.user .ai-msg-bubble {
        background: var(--ai-primary);
        color: #fff;
        border-radius: 12px 12px 2px 12px;
    }

    .ai-msg-row.ai .ai-msg-bubble {
        background: transparent;
        padding: 0;
        color: inherit;
        max-width: 100%;
    }

        .ai-msg-row.ai .ai-msg-bubble .ai-answer-label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--ai-accent);
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: .06em;
        }

    .ai-msg-bubble.ai-error {
        background: rgba(185, 28, 28, 0.06);
        border: 1px solid rgba(185, 28, 28, 0.22);
        color: #a11f1f;
        padding: 12px 16px;
    }

    .ai-markdown-body p:last-child {
        margin-bottom: 0;
    }

    /* ---- Yazıyor göstergesi ---- */
    .ai-typing {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 4px 2px;
    }

    .ai-loading-dots {
        display: flex;
        gap: 6px;
    }

        .ai-loading-dots span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--ai-accent);
            animation: ai-bounce 1.2s infinite ease-in-out both;
        }

            .ai-loading-dots span:nth-child(1) {
                animation-delay: -0.28s;
            }

            .ai-loading-dots span:nth-child(2) {
                animation-delay: -0.14s;
            }

    @@keyframes ai-bounce {
        0%, 80%, 100% {
            transform: scale(0.6);
            opacity: 0.5;
        }

        40% {
            transform: scale(1);
            opacity: 1;
        }
    }

    @@keyframes ai-fade-in {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ---- Alt sabit input, kutusuz stil ---- */
    .ai-input-wrapper {
        flex-shrink: 0;
        padding: 12px 24px 20px;
        display: flex;
        justify-content: center;
        background: var(--bs-body-bg, #fff);
    }

    .ai-input-inner {
        display: flex;
        align-items: center;
        gap: 10px;
        width: 100%;
        max-width: 820px;
        border: 1px solid var(--ai-border);
        border-radius: 24px;
        padding: 8px 10px 8px 18px;
    }

    .ai-input-icon {
        font-size: 18px;
        color: var(--ai-muted);
        flex-shrink: 0;
    }

    .ai-input {
        flex: 1;
        border: none;
        outline: none;
        background: transparent;
        font-size: 0.95rem;
        color: inherit;
        padding: 6px 4px;
    }

        .ai-input::placeholder {
            color: rgba(100, 116, 139, 0.65);
        }

    .ai-send-btn {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border: none;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--ai-primary);
        color: #fff;
        font-size: 15px;
        cursor: pointer;
        transition: background .15s ease;
    }

        .ai-send-btn:hover {
            background: var(--ai-primary-dark);
        }

        .ai-send-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
        }
</style>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
<script>
    (function () {

        const jwtToken = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.JwtToken ?? ""));
        const apiBaseUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.ApiBaseUrl ?? ""));

        const input = document.getElementById('aiQueryInput');
        const btn = document.getElementById('aiAskBtn');
        const messages = document.getElementById('aiChatMessages');
        const emptyState = document.getElementById('aiEmptyState');
        const suggestions = document.getElementById('aiSuggestions');

        function scrollToBottom() {
            messages.scrollTop = messages.scrollHeight;
        }

        function hideEmptyState() {
            if (emptyState) emptyState.remove();
        }

        function addUserMessage(text) {
            hideEmptyState();
            const row = document.createElement('div');
            row.className = 'ai-msg-row user';
            row.innerHTML = `<div class="ai-msg-bubble">${escapeHtml(text)}</div>`;
            messages.appendChild(row);
            scrollToBottom();
        }

        function addTypingIndicator() {
            hideEmptyState();
            const row = document.createElement('div');
            row.className = 'ai-msg-row ai';
            row.id = 'aiTypingRow';
            row.innerHTML = `
                <div class="ai-msg-bubble">
                    <div class="ai-typing">
                        <div class="ai-loading-dots">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </div>
            `;
            messages.appendChild(row);
            scrollToBottom();
        }

        function removeTypingIndicator() {
            const row = document.getElementById('aiTypingRow');
            if (row) row.remove();
        }

        function addAiMessage(answer) {
            const row = document.createElement('div');
            row.className = 'ai-msg-row ai';
            row.innerHTML = `
                <div class="ai-msg-bubble">
                    <div class="ai-answer-label">
                        <ion-icon name="analytics-outline"></ion-icon>
                        AI Yanıtı
                    </div>
                    <div class="ai-markdown-body">${marked.parse(answer)}</div>
                </div>
            `;
            messages.appendChild(row);
            scrollToBottom();
        }

        function addErrorMessage(text) {
            const row = document.createElement('div');
            row.className = 'ai-msg-row ai';
            row.innerHTML = `<div class="ai-msg-bubble ai-error">Bir hata oluştu:<br>${escapeHtml(text)}</div>`;
            messages.appendChild(row);
            scrollToBottom();
        }

        async function askAi(query) {

            const q = (query ?? input.value).trim();
            if (!q) return;

            addUserMessage(q);
            input.value = '';
            btn.disabled = true;
            addTypingIndicator();

            try {

                const url = `${apiBaseUrl}/Ai/ask`;
                const requestBody = { Message: q };

                const res = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'Authorization': `Bearer ${jwtToken}`
                    },
                    body: JSON.stringify(requestBody)
                });

                const responseText = await res.text();

                if (!res.ok) {
                    throw new Error(`İstek başarısız. HTTP ${res.status} - ${responseText}`);
                }

                let data;
                try {
                    data = JSON.parse(responseText);
                }
                catch {
                    data = { answer: responseText };
                }

                removeTypingIndicator();

                const answer =
                    data?.response ??
                    data?.answer ??
                    data?.message ??
                    data?.result ??
                    JSON.stringify(data);

                addAiMessage(answer);

            }
            catch (err) {
                removeTypingIndicator();
                addErrorMessage(err.message);
            }
            finally {
                btn.disabled = false;
                input.focus();
            }
        }

        function escapeHtml(value) {
            return String(value)
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        btn.addEventListener('click', function () { askAi(); });

        input.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                askAi();
            }
        });

        if (suggestions) {
            suggestions.addEventListener('click', function (e) {
                const chip = e.target.closest('.ai-chip');
                if (!chip) return;
                askAi(chip.textContent.trim());
            });
        }

    })();
</script>